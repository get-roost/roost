<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests del panel web sin daemon, sin binarios y sin red: Kestrel de verdad en un puerto libre de
    127.0.0.1 sobre una raíz de Roost temporal (la seguridad: token, cookie, Host, Origin, CSP; y la API,
    que con la raíz vacía contesta «parado»), más las reglas puras de PanelSecurity y el fichero panel.json.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Roost.Panel\Roost.Panel.csproj" />
  </ItemGroup>

</Project>
