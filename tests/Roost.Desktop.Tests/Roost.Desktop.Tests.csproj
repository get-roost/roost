<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests de la app de escritorio con Avalonia.Headless: cada pantalla se monta sobre una raíz
    de Roost falsa (sin daemon, sin red) y se dibuja de verdad con Skia. Además de comprobar
    que las vistas cargan, deja una captura PNG de cada una (ver ViewSnapshotTests).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Roost.Desktop\Roost.Desktop.csproj" />
  </ItemGroup>

</Project>
