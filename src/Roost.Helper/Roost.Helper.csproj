<Project Sdk="Microsoft.NET.Sdk">

  <!--
    roost-helper: lo único de Roost que se ejecuta con privilegios (ROOST.md §5.1, decisión 5).
    A propósito sin dependencias: solo su Program.cs, y HostsBlock.cs y NrptScripts.cs de
    Roost.Core enlazados como fuente, para que lo que puede escribir en el hosts (y la regla de DNS
    que pone) lo decida código de Core probado por los tests.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>roost-helper</AssemblyName>
    <ApplicationIcon>../../assets/branding/icons/roost.ico</ApplicationIcon>
    <RootNamespace>Roost.Helper</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Roost.Core\Sites\HostsBlock.cs" Link="HostsBlock.cs" />
    <Compile Include="..\Roost.Core\Dns\NrptScripts.cs" Link="NrptScripts.cs" />
  </ItemGroup>

</Project>
