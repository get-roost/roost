<Project Sdk="Microsoft.NET.Sdk">

  <!--
    La app de escritorio (ROOST.md §5.2): Avalonia, MVVM. No tiene lógica de negocio propia:
    usa Roost.Core (instalar, configurar, auditar) y habla con roostd como la CLI.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>roost-desktop</AssemblyName>
    <ApplicationIcon>../../assets/branding/icons/roost.ico</ApplicationIcon>
    <RootNamespace>Roost.Desktop</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      Como la CLI: sin ICU. En Linux la app no exige así el libicu de cada distro (libicu74, 70, 72…), y en
      todos los sistemas los números y las fechas en castellano salen de Services/Es, no del sistema.
      PredefinedCulturesOnly a false: una extensión que pida una cultura por nombre recibe la invariante
      en vez de un error.
    -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Roost.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Roost.Core\Roost.Core.csproj" />
    <ProjectReference Include="..\Roost.Daemon\Roost.Daemon.csproj" />
    <!-- Para llevar al lado roost.exe (que hace de daemon) y roost-helper.exe (el hosts). -->
    <ProjectReference Include="..\Roost.Cli\Roost.Cli.csproj" />
    <ProjectReference Include="..\Roost.Helper\Roost.Helper.csproj" />
    <ProjectReference Include="..\Roost.Shim\Roost.Shim.csproj" />
    <ProjectReference Include="..\Roost.Extensibility\Roost.Extensibility.csproj" />
  </ItemGroup>

</Project>
