<!--
  Estilos de Roost sobre el tema Fluent. Los botones tienen tema propio (el del mockup) y se
  combinan por clases: primary, ghost, danger, danger-fill, sm, icon, nav, tile, vcard, link.
  Los textos, por clases de TextBlock: h1, h2, sub, muted, faint, strong, mono, small.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Roost.Desktop.Controls">

  <Styles.Resources>
    <CornerRadius x:Key="ControlCornerRadius">7</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>

    <!-- Botón -->
    <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="RenderTransform" Value="scale(0.98)" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="Cursor" Value="Arrow" />
      </Style>
      <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      </Style>

      <Style Selector="^.primary">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
      </Style>
      <Style Selector="^.primary:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
      </Style>
      <Style Selector="^.danger">
        <Setter Property="Foreground" Value="{DynamicResource BadBrush}" />
      </Style>
      <Style Selector="^.danger-fill">
        <Setter Property="Background" Value="{DynamicResource BadBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BadBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
      </Style>
      <Style Selector="^.danger-fill:pointerover">
        <Setter Property="Background" Value="{DynamicResource BadDotBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BadDotBrush}" />
      </Style>
      <Style Selector="^.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>
      <Style Selector="^.ghost:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      </Style>
      <Style Selector="^.sm">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12" />
      </Style>
      <Style Selector="^.icon">
        <Setter Property="Width" Value="34" />
        <Setter Property="Padding" Value="0" />
      </Style>
      <Style Selector="^.sm.icon">
        <Setter Property="Width" Value="30" />
      </Style>
      <Style Selector="^.link">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Height" Value="NaN" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontWeight" Value="Normal" />
      </Style>
      <Style Selector="^.link:pointerover">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
      </Style>

      <!-- Botones de la ventana (barra de título) -->
      <Style Selector="^.winbtn">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="39" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="Cursor" Value="Arrow" />
      </Style>
      <Style Selector="^.winbtn:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      </Style>
      <Style Selector="^.winbtn.close:pointerover">
        <Setter Property="Background" Value="#C42B1C" />
        <Setter Property="Foreground" Value="#FFFFFF" />
      </Style>
      <Style Selector="^.winbtn:pressed">
        <Setter Property="RenderTransform" Value="none" />
      </Style>

      <!-- Barra lateral -->
      <Style Selector="^.nav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource SideTextBrush}" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      </Style>
      <Style Selector="^.nav:pointerover">
        <Setter Property="Background" Value="{DynamicResource SideHoverBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
      </Style>
      <Style Selector="^.nav.on">
        <Setter Property="Background" Value="{DynamicResource SideActiveBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
      </Style>
      <!-- El aviso de versión nueva, al pie de la barra lateral -->
      <Style Selector="^.sideupdate">
        <Setter Property="Background" Value="{DynamicResource SideHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SideLineBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SideTextBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Height" Value="NaN" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      </Style>
      <Style Selector="^.sideupdate:pointerover">
        <Setter Property="Background" Value="{DynamicResource SideActiveBrush}" />
      </Style>
      <Style Selector="^.bigtoggle">
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
      </Style>
      <Style Selector="^.bigtoggle.stop">
        <Setter Property="Background" Value="{DynamicResource StopBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource StopTextBrush}" />
      </Style>
      <Style Selector="^.bigtoggle.stop:pointerover">
        <Setter Property="Background" Value="{DynamicResource StopHoverBrush}" />
      </Style>
      <Style Selector="^.bigtoggle.start">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
      </Style>
      <Style Selector="^.bigtoggle.start:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
      </Style>

      <!-- Accesos de Inicio y tarjetas de versión -->
      <Style Selector="^.tile">
        <Setter Property="Height" Value="NaN" />
        <Setter Property="MinHeight" Value="92" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
      </Style>
      <Style Selector="^.tile:pointerover">
        <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TileHoverLineBrush}" />
      </Style>
      <Style Selector="^.vcard">
        <Setter Property="Height" Value="NaN" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
      </Style>
      <Style Selector="^.vcard:pointerover">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TileHoverLineBrush}" />
      </Style>
      <Style Selector="^.vcard.sel">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="13,11" />
      </Style>
      <!-- Extensiones de PHP -->
      <Style Selector="^.ext">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Normal" />
      </Style>
      <Style Selector="^.ext.on">
        <Setter Property="Background" Value="{DynamicResource OkBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OkLineBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
      </Style>
      <Style Selector="^.ext.dashed">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource FieldLineBrush}" />
      </Style>

      <!-- Filas pulsables de las listas (sitios, hallazgos, registros) -->
      <Style Selector="^.row">
        <Setter Property="Height" Value="NaN" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      </Style>
      <Style Selector="^.row:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      </Style>
      <Style Selector="^.row.sel">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      </Style>
      <Style Selector="^.row:pressed">
        <Setter Property="RenderTransform" Value="none" />
      </Style>
    </ControlTheme>

    <!-- Selector segmentado (NTS/TS, x64/x86, filtros): RadioButton con la clase seg -->
    <ControlTheme x:Key="SegButton" TargetType="RadioButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            VerticalContentAlignment="Center" />
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      </Style>
      <Style Selector="^:checked">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.5" />
      </Style>
    </ControlTheme>

    <!-- Chip -->
    <ControlTheme x:Key="{x:Type ctl:Chip}" TargetType="ctl:Chip">
      <Setter Property="Background" Value="{DynamicResource NeutralBgBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource NeutralBrush}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="11" Height="22" Padding="8,0">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <ctl:Dot Tone="{TemplateBinding Tone}" IsVisible="{TemplateBinding ShowDot}" VerticalAlignment="Center" />
              <TextBlock Text="{TemplateBinding Text}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^[Tone=Ok]">
        <Setter Property="Background" Value="{DynamicResource OkBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
      </Style>
      <Style Selector="^[Tone=Warn]">
        <Setter Property="Background" Value="{DynamicResource WarnBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
      </Style>
      <Style Selector="^[Tone=Bad]">
        <Setter Property="Background" Value="{DynamicResource BadBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource BadBrush}" />
      </Style>
      <Style Selector="^[Tone=Accent]">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      </Style>
    </ControlTheme>

    <!-- Aviso en línea -->
    <ControlTheme x:Key="{x:Type ctl:Note}" TargetType="ctl:Note">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource NoteInfoTextBrush}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <ctl:Icon Name="PART_Icon" Data="{DynamicResource IcInfo}" VerticalAlignment="Top" Margin="0,1,0,0" />
              <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" TextWrapping="Wrap" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^[Tone=Ok]">
        <Setter Property="Background" Value="{DynamicResource OkBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource NoteOkTextBrush}" />
        <Style Selector="^ /template/ ctl|Icon#PART_Icon">
          <Setter Property="Data" Value="{DynamicResource IcCheck}" />
        </Style>
      </Style>
      <Style Selector="^[Tone=Warn]">
        <Setter Property="Background" Value="{DynamicResource WarnBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource NoteWarnTextBrush}" />
        <Style Selector="^ /template/ ctl|Icon#PART_Icon">
          <Setter Property="Data" Value="{DynamicResource IcWarning}" />
        </Style>
      </Style>
      <Style Selector="^[Tone=Bad]">
        <Setter Property="Background" Value="{DynamicResource BadBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource NoteBadTextBrush}" />
        <Style Selector="^ /template/ ctl|Icon#PART_Icon">
          <Setter Property="Data" Value="{DynamicResource IcError}" />
        </Style>
      </Style>
    </ControlTheme>
  </Styles.Resources>

  <!-- La última fila de una lista no lleva separador: ya cierra la tarjeta -->
  <Style Selector="ContentPresenter:nth-last-child(1) > Border.tr">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Puntos -->
  <Style Selector="ctl|Dot">
    <Setter Property="Fill" Value="{DynamicResource OffDotBrush}" />
  </Style>
  <Style Selector="ctl|Dot[Tone=Ok]">
    <Setter Property="Fill" Value="{DynamicResource OkDotBrush}" />
  </Style>
  <Style Selector="ctl|Dot[Tone=Warn]">
    <Setter Property="Fill" Value="{DynamicResource WarnDotBrush}" />
  </Style>
  <Style Selector="ctl|Dot[Tone=Bad]">
    <Setter Property="Fill" Value="{DynamicResource BadDotBrush}" />
  </Style>
  <Style Selector="ctl|Dot[Tone=Accent]">
    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Textos -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.2" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.sub">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.strong">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.lbl">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.navlabel">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.4" />
    <Setter Property="Foreground" Value="{DynamicResource SideMutedBrush}" />
    <Setter Property="Margin" Value="10,10,10,4" />
  </Style>
  <Style Selector="TextBlock.ver">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <!-- Paneles -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.card-h">
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="MinHeight" Value="50" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line2Brush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.card-b">
    <Setter Property="Padding" Value="16,14" />
  </Style>
  <!-- Fila de tabla o de lista: separador inferior -->
  <Style Selector="Border.tr">
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line2Brush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.th">
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line2Brush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.th TextBlock">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="Border.seg">
    <Setter Property="Background" Value="{DynamicResource NeutralBgBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Border.modal">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="BoxShadow" Value="0 24 64 0 #59000000" />
    <Setter Property="MaxWidth" Value="560" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.modal.wide">
    <Setter Property="MaxWidth" Value="720" />
  </Style>
  <Style Selector="Border.modal-f">
    <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line2Brush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="20,14" />
  </Style>
  <Style Selector="Border.badge-ic">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Border.badge-ic.warn">
    <Setter Property="Background" Value="{DynamicResource WarnBgBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource WarnBrush}" />
  </Style>
  <Style Selector="Border.badge-ic.bad">
    <Setter Property="Background" Value="{DynamicResource BadBgBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource BadBrush}" />
  </Style>
  <Style Selector="Border.tile-ic">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Border.tile-ic.bad">
    <Setter Property="Background" Value="{DynamicResource BadBgBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource BadBrush}" />
  </Style>
  <Style Selector="Border.tile-ic.warn">
    <Setter Property="Background" Value="{DynamicResource WarnBgBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource WarnBrush}" />
  </Style>
  <Style Selector="Border.tile-ic.ok">
    <Setter Property="Background" Value="{DynamicResource OkBgBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource OkBrush}" />
  </Style>
  <!-- Pasos de una instalación -->
  <Style Selector="Border.step">
    <Setter Property="Background" Value="{DynamicResource NeutralBgBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="Border.step.active">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Border.step.done">
    <Setter Property="Background" Value="{DynamicResource OkBgBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource OkBrush}" />
  </Style>
  <Style Selector="Border.step.failed">
    <Setter Property="Background" Value="{DynamicResource BadBgBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource BadBrush}" />
  </Style>

  <!-- Líneas de registro: en mono, con color según lo que cuentan -->
  <Style Selector="TextBlock.logline">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="19" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource LogTextBrush}" />
  </Style>
  <Style Selector="TextBlock.logline.e">
    <Setter Property="Foreground" Value="#FF8A80" />
  </Style>
  <Style Selector="TextBlock.logline.w">
    <Setter Property="Foreground" Value="#F5C451" />
  </Style>
  <Style Selector="TextBlock.logline.m">
    <Setter Property="Foreground" Value="#8E98A4" />
  </Style>

  <Style Selector="Border.log">
    <Setter Property="Background" Value="{DynamicResource LogBgBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <Style Selector="Border.count">
    <Setter Property="MinWidth" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{DynamicResource BadDotBrush}" />
  </Style>
  <Style Selector="Border.count TextBlock">
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Campos -->
  <!-- Un valor de solo lectura con aspecto de campo (host, puerto, usuario de la base de datos) -->
  <Style Selector="Border.field">
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource FieldLineBrush}" />
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
  </Style>
  <Style Selector="Border.field > TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="Height" Value="8" />
    <Setter Property="MinHeight" Value="8" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource NeutralBgBrush}" />
  </Style>

  <!-- Actualizador: las novedades de la release en el modal «Roost X disponible» -->
  <Style Selector="SelectableTextBlock.notes">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="SelectableTextBlock.notes.heading">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="SelectableTextBlock.notes.code">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource LogTextBrush}" />
  </Style>
</Styles>
