<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Roost.Desktop.ViewModels"
             xmlns:ctl="using:Roost.Desktop.Controls"
             x:Class="Roost.Desktop.Views.DbPasswordDialogView"
             x:DataType="vm:DbPasswordDialogViewModel">
  <Border Classes="modal" Width="560">
    <DockPanel>
      <Border DockPanel.Dock="Bottom" Classes="modal-f">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Cancelar" Command="{Binding DismissCommand}" />
          <Button Classes="primary" Content="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}" IsEnabled="{Binding CanConfirm}" IsDefault="True" />
        </StackPanel>
      </Border>
      <StackPanel Spacing="14" Margin="20,18,20,18">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <Border Classes="badge-ic">
            <ctl:Icon Data="{StaticResource IcKey}" Size="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Classes="h3" Text="{Binding Title}" />
            <TextBlock Classes="faint" Text="{Binding Subtitle}" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="2" Classes="icon ghost" VerticalAlignment="Top" Command="{Binding DismissCommand}" AutomationProperties.Name="Cerrar">
            <ctl:Icon Data="{StaticResource IcClose}" Size="15" />
          </Button>
        </Grid>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
          <StackPanel Spacing="6">
            <TextBlock Classes="lbl" Text="Contraseña" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBox Classes="mono" Text="{Binding Password}" PasswordChar="•" RevealPassword="{Binding Show}" AutomationProperties.Name="Contraseña" />
              <Button Grid.Column="1" Classes="icon" Command="{Binding ToggleShowCommand}" AutomationProperties.Name="Ver u ocultar la contraseña"
                      ToolTip.Tip="Ver u ocultar">
                <Panel>
                  <ctl:Icon Data="{StaticResource IcEye}" Size="15" IsVisible="{Binding !Show}" />
                  <ctl:Icon Data="{StaticResource IcEyeOff}" Size="15" IsVisible="{Binding Show}" />
                </Panel>
              </Button>
            </Grid>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="6">
            <TextBlock Classes="lbl" Text="Repítela" />
            <TextBox Classes="mono" Text="{Binding Repeat}" PasswordChar="•" RevealPassword="{Binding Show}" AutomationProperties.Name="Repetir la contraseña" />
          </StackPanel>
        </Grid>

        <TextBlock Classes="small" TextWrapping="Wrap" Foreground="{DynamicResource BadBrush}" Text="{Binding Hint}" IsVisible="{Binding HasHint}" />
        <TextBlock Classes="faint" TextWrapping="Wrap" IsVisible="{Binding ForRoot}">
          <Run Text="{Binding EmptyHint, Mode=OneWay}" />
          <Run Text=" Vale cualquier texto ASCII sin espacios ni ' &quot; \ `, hasta 64 caracteres: así va tal cual en el SQL y en el my.ini." />
        </TextBlock>

        <CheckBox IsChecked="{Binding SaveOnly}" IsVisible="{Binding ForRoot}">
          <StackPanel>
            <TextBlock Text="Solo guardarla en Roost: ya la cambié por fuera" />
            <TextBlock Classes="faint" Text="No se toca el servidor; Roost comprueba que root entra con ella." TextWrapping="Wrap" />
          </StackPanel>
        </CheckBox>

        <ctl:Note Tone="Accent" Content="{Binding Note}" />
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
