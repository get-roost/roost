<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Roost.Desktop.ViewModels"
             xmlns:ctl="using:Roost.Desktop.Controls"
             x:Class="Roost.Desktop.Views.GitTokenDialogView"
             x:DataType="vm:GitTokenDialogViewModel">
  <!-- Git-app: Sustituir o guardar un token (Acceso… y Ajustes › Git) -->
  <Border Classes="modal" Width="560">
    <DockPanel>
      <Border DockPanel.Dock="Bottom" Classes="modal-f">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Cancelar" Command="{Binding DismissCommand}" />
          <Button Classes="primary" Content="Guardar" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" />
        </StackPanel>
      </Border>
      <StackPanel Spacing="14" Margin="20,18,20,18">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <Border Classes="badge-ic">
            <ctl:Icon Data="{StaticResource IcKey}" Size="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Classes="h3" Text="{Binding Title}" TextWrapping="Wrap" />
            <TextBlock Classes="faint mono" Text="{Binding Where}" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="2" Classes="icon ghost" VerticalAlignment="Top" Command="{Binding DismissCommand}" AutomationProperties.Name="Cerrar">
            <ctl:Icon Data="{StaticResource IcClose}" Size="15" />
          </Button>
        </Grid>
        <Grid ColumnDefinitions="180,*" ColumnSpacing="14">
          <StackPanel Spacing="6">
            <TextBlock Classes="lbl" Text="Usuario (opcional)" />
            <TextBox Classes="mono" Text="{Binding User}" AutomationProperties.Name="Usuario del token" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="6">
            <TextBlock Classes="lbl" Text="Token" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBox Classes="mono" Text="{Binding Token}" PasswordChar="•" RevealPassword="{Binding ShowToken}" AutomationProperties.Name="Token" />
              <Button Grid.Column="1" Classes="icon" Command="{Binding ToggleShowTokenCommand}" ToolTip.Tip="Ver u ocultar" AutomationProperties.Name="Ver u ocultar el token">
                <Panel>
                  <ctl:Icon Data="{StaticResource IcEye}" Size="15" IsVisible="{Binding !ShowToken}" />
                  <ctl:Icon Data="{StaticResource IcEyeOff}" Size="15" IsVisible="{Binding ShowToken}" />
                </Panel>
              </Button>
            </Grid>
          </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="sm" Command="{Binding CreateTokenCommand}" IsVisible="{Binding HasNewTokenUrl}" AutomationProperties.Name="Crear un token">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Crear un token" VerticalAlignment="Center" />
              <ctl:Icon Data="{StaticResource IcExternal}" Size="13" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <TextBlock Classes="faint" VerticalAlignment="Center" Text="{Binding Permission, StringFormat='Permiso que necesita: {0}.'}" />
        </StackPanel>
        <ctl:Note Tone="Warn" IsVisible="{Binding HasWarning}" Content="{Binding Warning}" />
        <TextBlock Classes="faint" Text="{Binding StorageText}" TextWrapping="Wrap" />
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
