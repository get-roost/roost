<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Roost.Desktop.ViewModels"
             xmlns:ctl="using:Roost.Desktop.Controls"
             x:Class="Roost.Desktop.Views.NewSiteDialogView"
             x:DataType="vm:NewSiteDialogViewModel">
  <Border Classes="modal wide" Width="720">
    <DockPanel>
      <Border DockPanel.Dock="Bottom" Classes="modal-f">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Cancelar" Command="{Binding DismissCommand}" />
          <Button Classes="primary" Content="Crear y abrir" Command="{Binding CreateCommand}" IsEnabled="{Binding CanCreate}" />
        </StackPanel>
      </Border>
      <ScrollViewer MaxHeight="600">
        <StackPanel Spacing="14" Margin="20,18,20,18">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Border Classes="badge-ic">
              <ctl:Icon Data="{StaticResource IcPlus}" Size="18" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Classes="h3" Text="Nuevo sitio" />
              <TextBlock Classes="faint" Text="Repetirlo sobre un sitio que ya existe solo lo actualiza." />
            </StackPanel>
            <Button Grid.Column="2" Classes="icon ghost" VerticalAlignment="Top" Command="{Binding DismissCommand}" AutomationProperties.Name="Cerrar">
              <ctl:Icon Data="{StaticResource IcClose}" Size="15" />
            </Button>
          </Grid>

          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="14">
            <StackPanel Spacing="6">
              <TextBlock Classes="lbl" Text="Nombre" />
              <TextBox Classes="mono" Text="{Binding Name}" PlaceholderText="tienda" AutomationProperties.Name="Nombre del sitio" />
              <TextBlock Classes="small" Text="{Binding NameHint}" TextWrapping="Wrap"
                         Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6">
              <DockPanel>
                <ctl:Chip DockPanel.Dock="Right" Text="{Binding ProjectLabel}" Tone="Accent" IsVisible="{Binding HasProject}" Margin="0,-4,0,-4" />
                <TextBlock Classes="lbl" Text="Carpeta" VerticalAlignment="Center" />
              </DockPanel>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBox Classes="mono" Text="{Binding Folder}" AutomationProperties.Name="Carpeta del sitio" />
                <Button Grid.Column="1" Classes="icon" Command="{Binding BrowseCommand}" ToolTip.Tip="Elegir carpeta" AutomationProperties.Name="Elegir carpeta">
                  <ctl:Icon Data="{StaticResource IcFolder}" Size="15" />
                </Button>
              </Grid>
              <TextBlock Classes="faint" Text="{Binding FolderHint}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="6">
              <TextBlock Classes="lbl" Text="Raíz web (dentro de la carpeta; opcional)" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBox Classes="mono" Text="{Binding Root}" PlaceholderText="public" AutomationProperties.Name="Raíz web del sitio" />
                <Button Grid.Column="1" Classes="icon" Command="{Binding BrowseRootCommand}" IsEnabled="{Binding FolderExists}"
                        ToolTip.Tip="Elegir la subcarpeta que se sirve" AutomationProperties.Name="Elegir raíz web">
                  <ctl:Icon Data="{StaticResource IcFolder}" Size="15" />
                </Button>
              </Grid>
              <TextBlock Classes="faint" Text="{Binding RootHint}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Row="2" Spacing="6">
              <TextBlock Classes="lbl" Text="PHP" />
              <ComboBox ItemsSource="{Binding PhpOptions}" SelectedItem="{Binding Php}" HorizontalAlignment="Stretch" AutomationProperties.Name="PHP del sitio" />
              <Button Classes="link" Content="Instalar otra versión…" HorizontalAlignment="Left" FontSize="12" Command="{Binding InstallOtherCommand}"
                      ToolTip.Tip="Sin cerrar este diálogo: lo tecleado se queda" />
              <StackPanel Spacing="6" IsVisible="{Binding ShowInstallChoices}">
                <TextBlock Classes="faint" Text="{Binding InstallChoicesHint}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding InstallChoices}" IsVisible="{Binding HasInstallChoices}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PhpInstallChoice">
                      <Button Classes="chip" Content="{Binding Label}" ToolTip.Tip="Instalar esta versión y usarla en el sitio"
                              Command="{Binding $parent[ItemsControl].((vm:NewSiteDialogViewModel)DataContext).InstallPhpCommand}" CommandParameter="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="1" Spacing="6">
              <TextBlock Classes="lbl" Text="{Binding DbLabel, StringFormat='Base de datos · {0}'}" />
              <Border Classes="seg" IsEnabled="{Binding HasDb}">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <RadioButton Theme="{StaticResource SegButton}" GroupName="basedatos" Content="Crear una" IsChecked="{Binding DbIsCreate}" />
                  <RadioButton Theme="{StaticResource SegButton}" GroupName="basedatos" Content="Usar una que existe" IsChecked="{Binding DbIsExisting}" />
                  <RadioButton Theme="{StaticResource SegButton}" GroupName="basedatos" Content="Ninguna" IsChecked="{Binding DbIsNone}" />
                </StackPanel>
              </Border>
              <TextBox Classes="mono" Text="{Binding DbName}" IsVisible="{Binding DbIsCreate}" PlaceholderText="tienda" AutomationProperties.Name="Nombre de la base de datos nueva" />
              <ComboBox ItemsSource="{Binding ExistingDbs}" SelectedItem="{Binding ExistingDb}" IsVisible="{Binding ShowExistingList}"
                        HorizontalAlignment="Stretch" PlaceholderText="Elige una" AutomationProperties.Name="Base de datos que ya existe" />
              <TextBox Classes="mono" Text="{Binding ExistingDb}" IsVisible="{Binding ShowExistingText}" PlaceholderText="nombre de la que ya existe"
                       AutomationProperties.Name="Base de datos que ya existe" />
              <TextBlock Classes="small" Text="{Binding DbHint}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" IsVisible="{Binding DbValid}" />
              <TextBlock Classes="small" Text="{Binding DbHint}" TextWrapping="Wrap" Foreground="{DynamicResource BadBrush}" IsVisible="{Binding !DbValid}" />
            </StackPanel>
          </Grid>

          <StackPanel Spacing="6">
            <TextBlock Classes="lbl" Text="Plantilla" />
            <Border Classes="seg">
              <ItemsControl ItemsSource="{Binding Templates}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SiteTemplate">
                    <RadioButton Theme="{StaticResource SegButton}" GroupName="plantilla" Content="{Binding Label}" IsEnabled="{Binding Available}"
                                 IsChecked="{Binding Available, Mode=OneTime}" ToolTip.Tip="{Binding Hint}" ToolTip.ShowOnDisabled="True"
                                 Command="{Binding $parent[ItemsControl].((vm:NewSiteDialogViewModel)DataContext).PickTemplateCommand}" CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
            <TextBlock Classes="faint" Text="{Binding Template.Hint}" TextWrapping="Wrap" />
          </StackPanel>

          <Border Background="{DynamicResource WinBrush}" CornerRadius="8" Padding="14,12">
            <StackPanel Spacing="10">
              <TextBlock Classes="lbl" Text="Al crear, Roost:" />
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <ctl:Dot Tone="Ok" VerticalAlignment="Top" Margin="0,5,0,0" />
                <TextBlock Grid.Column="1" Classes="small" Text="{Binding StepFolder}" TextWrapping="Wrap" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <ctl:Dot Tone="Ok" VerticalAlignment="Top" Margin="0,5,0,0" />
                <TextBlock Grid.Column="1" Classes="small" TextWrapping="Wrap">
                  <Run Text="Escribe el vhost del servidor web y emite el certificado de " />
                  <Run Text="{Binding Host, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                  <Run Text=" y " />
                  <Run Text="{Binding Host, StringFormat='*.{0}', Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                </TextBlock>
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding UsesLocalDns}">
                <ctl:Dot Tone="Ok" VerticalAlignment="Top" Margin="0,5,0,0" />
                <TextBlock Grid.Column="1" Classes="small" TextWrapping="Wrap">
                  <Run Text="{Binding Host, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                  <Run Text=" ya resuelve: lo responde el DNS local de Roost, sin permisos" />
                </TextBlock>
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding UsesHosts}">
                <ctl:Dot Tone="Warn" VerticalAlignment="Top" Margin="0,5,0,0" />
                <TextBlock Grid.Column="1" Classes="small" TextWrapping="Wrap">
                  <Run Text="Añade " />
                  <Run Text="{Binding Host, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                  <Run Text=" al hosts: Windows pedirá permiso de administrador" />
                </TextBlock>
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding DbIsCreate}">
                <ctl:Dot Tone="Ok" VerticalAlignment="Top" Margin="0,5,0,0" />
                <TextBlock Grid.Column="1" TextWrapping="Wrap" Classes="small">
                  <Run Text="Crea la base de datos " />
                  <Run Text="{Binding DbName, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                  <Run Text=" (utf8mb4)" />
                </TextBlock>
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding DbIsExisting}">
                <ctl:Dot Tone="Ok" VerticalAlignment="Top" Margin="0,5,0,0" />
                <TextBlock Grid.Column="1" TextWrapping="Wrap" Classes="small">
                  <Run Text="Usa la base de datos " />
                  <Run Text="{Binding ExistingDb, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                  <Run Text=" (ya existe: no se toca)" />
                </TextBlock>
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <ctl:Dot Tone="Ok" VerticalAlignment="Top" Margin="0,5,0,0" />
                <TextBlock Grid.Column="1" TextWrapping="Wrap" Classes="small">
                  <Run Text="Recarga el stack y abre " />
                  <Run Text="{Binding Host, StringFormat='https://{0}/', Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                </TextBlock>
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding NeedsComposerInstall}">
                <ctl:Dot Tone="Warn" VerticalAlignment="Top" Margin="0,5,0,0" />
                <TextBlock Grid.Column="1" TextWrapping="Wrap" Classes="small">
                  <Run Text="Le falta " />
                  <Run Text="vendor/" FontFamily="{StaticResource MonoFont}" />
                  <Run Text=": después, «Instalar dependencias» en el panel del sitio (composer install)" />
                </TextBlock>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
