<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Roost.Desktop.ViewModels"
             xmlns:ctl="using:Roost.Desktop.Controls"
             x:Class="Roost.Desktop.Views.DbUserDialogView"
             x:DataType="vm:DbUserDialogViewModel">
  <Border Classes="modal" Width="560">
    <DockPanel>
      <Border DockPanel.Dock="Bottom" Classes="modal-f">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Cancelar" Command="{Binding DismissCommand}" />
          <Button Classes="primary" Content="Crear usuario" Command="{Binding ConfirmCommand}" IsEnabled="{Binding CanConfirm}" IsDefault="True" />
        </StackPanel>
      </Border>
      <StackPanel Spacing="14" Margin="20,18,20,18">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <Border Classes="badge-ic">
            <ctl:Icon Data="{StaticResource IcUser}" Size="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Classes="h3" Text="Nuevo usuario" />
            <TextBlock Classes="faint" Text="{Binding Subtitle}" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="2" Classes="icon ghost" VerticalAlignment="Top" Command="{Binding DismissCommand}" AutomationProperties.Name="Cerrar">
            <ctl:Icon Data="{StaticResource IcClose}" Size="15" />
          </Button>
        </Grid>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
          <StackPanel Spacing="6">
            <TextBlock Classes="lbl" Text="Usuario" />
            <TextBox Classes="mono" Text="{Binding Name}" PlaceholderText="tienda" AutomationProperties.Name="Nombre del usuario" />
            <TextBlock Classes="small" TextWrapping="Wrap" Foreground="{DynamicResource BadBrush}" Text="{Binding NameHint}" IsVisible="{Binding HasNameHint}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="6">
            <TextBlock Classes="lbl" Text="Acceso a" />
            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Access}" HorizontalAlignment="Stretch" AutomationProperties.Name="Acceso a" />
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
          <StackPanel Spacing="6">
            <TextBlock Classes="lbl" Text="Contraseña" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBox Classes="mono" Text="{Binding Password}" PasswordChar="•" RevealPassword="{Binding Show}" AutomationProperties.Name="Contraseña del usuario" />
              <Button Grid.Column="1" Classes="icon" Command="{Binding ToggleShowCommand}" AutomationProperties.Name="Ver u ocultar la contraseña" ToolTip.Tip="Ver u ocultar">
                <Panel>
                  <ctl:Icon Data="{StaticResource IcEye}" Size="15" IsVisible="{Binding !Show}" />
                  <ctl:Icon Data="{StaticResource IcEyeOff}" Size="15" IsVisible="{Binding Show}" />
                </Panel>
              </Button>
            </Grid>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="6">
            <TextBlock Classes="lbl" Text="Repítela" />
            <TextBox Classes="mono" Text="{Binding Repeat}" PasswordChar="•" RevealPassword="{Binding Show}" AutomationProperties.Name="Repetir la contraseña del usuario" />
          </StackPanel>
        </Grid>
        <TextBlock Classes="small" TextWrapping="Wrap" Foreground="{DynamicResource BadBrush}" Text="{Binding PasswordHint}" IsVisible="{Binding HasPasswordHint}" />

        <ctl:Note Tone="Accent" Content="{Binding AccessHint}" />
        <TextBlock Classes="faint" TextWrapping="Wrap" Text="Al crearlo, Roost te ofrece copiar las líneas de su .env (DB_USERNAME, DB_PASSWORD…)." />
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
