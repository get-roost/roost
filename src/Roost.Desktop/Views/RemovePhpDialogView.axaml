<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Roost.Desktop.ViewModels"
             xmlns:ctl="using:Roost.Desktop.Controls"
             xmlns:sites="using:Roost.Core.Sites"
             x:Class="Roost.Desktop.Views.RemovePhpDialogView"
             x:DataType="vm:RemovePhpDialogViewModel">
  <Border Classes="modal" Width="560">
    <DockPanel>
      <Border DockPanel.Dock="Bottom" Classes="modal-f">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Cancelar" Command="{Binding DismissCommand}" />
          <Button Classes.danger-fill="{Binding Removes}" Content="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}" />
        </StackPanel>
      </Border>
      <StackPanel Spacing="14" Margin="20,18,20,18">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Border Classes="badge-ic warn">
            <ctl:Icon Data="{StaticResource IcWarning}" Size="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Classes="h3" Text="{Binding Title}" />
            <TextBlock Classes="faint" Text="{Binding Subtitle}" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>

        <Border BorderBrush="{DynamicResource Line2Brush}" BorderThickness="1" CornerRadius="8">
          <ItemsControl ItemsSource="{Binding Sites}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="sites:Site">
                <Border Classes="tr" MinHeight="40" Padding="14,8">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <TextBlock Classes="mono strong" Text="{Binding Host}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="faint" Text="{Binding Folder}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <ctl:Chip Grid.Column="2" Tone="Bad" Text="{Binding Php, StringFormat='PHP {0} fijado'}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <StackPanel Spacing="10">
          <TextBlock Classes="lbl" Text="{Binding Question}" />
          <RadioButton GroupName="destino" IsChecked="{Binding ToGlobal}">
            <StackPanel>
              <TextBlock>
                <Run Text="{Binding GlobalLabel, Mode=OneWay}" />
              </TextBlock>
              <TextBlock Classes="faint" Text="{Binding GlobalHint}" TextWrapping="Wrap" />
            </StackPanel>
          </RadioButton>
          <RadioButton GroupName="destino" IsChecked="{Binding ToOther}" IsVisible="{Binding HasOthers}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Pasarlo a otra versión instalada" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding Others}" SelectedItem="{Binding Other}" MinHeight="28" IsEnabled="{Binding ToOther}"
                        AutomationProperties.Name="Versión">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:PhpCard">
                    <TextBlock Classes="mono" Text="{Binding Version}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </RadioButton>
          <RadioButton GroupName="destino" IsChecked="{Binding Keep}">
            <TextBlock Text="{Binding Card.Version, StringFormat='No quitar PHP {0} todavía'}" />
          </RadioButton>
        </StackPanel>

        <ctl:Note Tone="Accent" Content="{Binding RemoveNote}" />
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
