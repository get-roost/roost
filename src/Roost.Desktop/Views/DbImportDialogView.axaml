<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Roost.Desktop.ViewModels"
             xmlns:ctl="using:Roost.Desktop.Controls"
             xmlns:sys="using:System"
             x:Class="Roost.Desktop.Views.DbImportDialogView"
             x:DataType="vm:DbImportDialogViewModel">
  <Border Classes="modal" Width="560">
    <DockPanel>
      <Border DockPanel.Dock="Bottom" Classes="modal-f">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Cancelar" Command="{Binding DismissCommand}" />
          <Button Classes="primary" Content="Importar" Command="{Binding ConfirmCommand}" IsEnabled="{Binding CanConfirm}" IsDefault="True" />
        </StackPanel>
      </Border>
      <StackPanel Spacing="14" Margin="20,18,20,18">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <Border Classes="badge-ic">
            <ctl:Icon Data="{StaticResource IcUpload}" Size="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Classes="h3" Text="Importar un volcado" />
            <TextBlock Classes="faint" Text="{Binding Subtitle}" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="2" Classes="icon ghost" VerticalAlignment="Top" Command="{Binding DismissCommand}" AutomationProperties.Name="Cerrar">
            <ctl:Icon Data="{StaticResource IcClose}" Size="15" />
          </Button>
        </Grid>

        <StackPanel Spacing="6">
          <TextBlock Classes="lbl" Text="Fichero" />
          <Border Classes="field">
            <StackPanel>
              <TextBlock Classes="mono strong" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding File}" />
              <TextBlock Classes="faint" Text="{Binding FileDetail}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Classes="lbl" Text="A qué base de datos" />
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
            <RadioButton GroupName="destino" Content="Una nueva" IsChecked="{Binding ToNew}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Classes="mono" Text="{Binding NewName}" IsEnabled="{Binding ToNew}" PlaceholderText="nombre"
                     AutomationProperties.Name="Nombre de la base de datos nueva" />
            <RadioButton Grid.Row="1" GroupName="destino" Content="Una que ya existe" IsChecked="{Binding ToExisting}" IsEnabled="{Binding HasExisting}" VerticalAlignment="Center" />
            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Existing}" SelectedItem="{Binding SelectedExisting}" IsEnabled="{Binding ToExisting}"
                      HorizontalAlignment="Stretch" AutomationProperties.Name="Base de datos que ya existe" />
          </Grid>
          <TextBlock Classes="small" TextWrapping="Wrap" Foreground="{DynamicResource BadBrush}" Text="{Binding NameHint}" IsVisible="{Binding HasNameHint}" />
          <TextBlock Classes="faint" TextWrapping="Wrap" Text="{Binding TargetHint}" />
        </StackPanel>

        <ctl:Note Tone="Warn" IsVisible="{Binding HasIssues}">
          <StackPanel Spacing="8">
            <TextBlock Classes="strong" Text="Trae cosas que este servidor no entiende" />
            <ItemsControl ItemsSource="{Binding Issues}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sys:String">
                  <TextBlock Classes="small" Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <CheckBox IsChecked="{Binding Compat}">
              <TextBlock Text="Adaptarlo al vuelo" />
            </CheckBox>
            <TextBlock Classes="faint" TextWrapping="Wrap" Text="{Binding CompatHint}" />
          </StackPanel>
        </ctl:Note>
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
