<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Roost.Desktop.ViewModels"
             xmlns:ctl="using:Roost.Desktop.Controls"
             xmlns:sys="using:System"
             x:Class="Roost.Desktop.Views.DbTransferDialogView"
             x:DataType="vm:DbTransferDialogViewModel">
  <Border Classes="modal wide" Width="720">
    <DockPanel>
      <Border DockPanel.Dock="Bottom" Classes="modal-f">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Cancelar" Command="{Binding CancelCommand}" IsVisible="{Binding Running}"
                  ToolTip.Tip="Para el proceso y todo lo que haya lanzado" />
          <Button Classes="primary" Content="Cerrar" Command="{Binding FinishCommand}" IsVisible="{Binding Done}" />
        </StackPanel>
      </Border>
      <StackPanel Spacing="14" Margin="20,18,20,18">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Border Classes="badge-ic" Classes.bad="{Binding Failed}">
            <ctl:Icon Data="{StaticResource IcDatabase}" Size="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Classes="h3" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="faint" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Subtitle}" />
          </StackPanel>
        </Grid>

        <StackPanel Spacing="6">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Classes="mono" Text="{Binding BytesText}" />
            <TextBlock Classes="small strong" Text="{Binding Phase}" />
          </DockPanel>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" IsIndeterminate="{Binding Indeterminate}"
                       AutomationProperties.Name="Progreso" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Steps}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:InstallStep">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Border Width="22" Height="22" CornerRadius="11"
                        Classes="step" Classes.done="{Binding IsDone}" Classes.active="{Binding IsActive}"
                        Classes.failed="{Binding Tone, Converter={x:Static ctl:ToneConverters.IsBad}}">
                  <Panel>
                    <ctl:Icon Data="{StaticResource IcCheck}" Size="13" StrokeThickness="2.4" IsVisible="{Binding IsDone}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <ctl:Icon Data="{StaticResource IcDot}" Size="12" Filled="True" IsVisible="{Binding !IsDone}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Panel>
                </Border>
                <TextBlock Grid.Column="1" Classes="small" VerticalAlignment="Center" TextWrapping="Wrap">
                  <Run Text="{Binding Label, Mode=OneWay}" FontWeight="{Binding IsActive, Converter={x:Static ctl:ToneConverters.Bold}}" />
                  <Run Text="{Binding Hint, Mode=OneWay}" Foreground="{DynamicResource FaintBrush}" />
                </TextBlock>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Classes="log" Padding="12,8" IsVisible="{Binding HasLines}">
          <ScrollViewer Name="OutputScroll" MaxHeight="120" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Lines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LogLine">
                  <TextBlock Classes="logline" Classes.e="{Binding IsError}" Classes.w="{Binding IsWarn}" Classes.m="{Binding IsMuted}"
                             Text="{Binding Text}" TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <ctl:Note Tone="Accent" IsVisible="{Binding HasNote}" Content="{Binding Note}" />

        <StackPanel Spacing="4" IsVisible="{Binding HasNotes}">
          <TextBlock Classes="lbl" Text="Por el camino" />
          <ItemsControl ItemsSource="{Binding Notes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="sys:String">
                <TextBlock Classes="small muted" Text="{Binding}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <ctl:Note Tone="{Binding ResultTone}" IsVisible="{Binding Done}" Content="{Binding ResultText}" />
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
