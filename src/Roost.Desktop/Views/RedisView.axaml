<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Roost.Desktop.ViewModels"
             xmlns:ctl="using:Roost.Desktop.Controls"
             xmlns:sys="using:System"
             x:Class="Roost.Desktop.Views.RedisView"
             x:DataType="vm:RedisViewModel">
  <ScrollViewer>
    <StackPanel>
      <Grid ColumnDefinitions="*,Auto" Margin="24,18,24,14">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Classes="h1" Text="Redis" />
          <TextBlock Classes="sub" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button Grid.Column="1" Content="Abrir redis-cli" Command="{Binding OpenCliCommand}" IsEnabled="{Binding Running}"
                ToolTip.Tip="Una consola de Redis conectada al de Roost" ToolTip.ShowOnDisabled="True" />
      </Grid>

      <StackPanel Margin="24,0,24,24" Spacing="16">
        <Grid ColumnDefinitions="*,340" ColumnSpacing="16">
          <!-- El de Roost: estado, en el stack, puerto, ficheros y .env -->
          <Border Classes="card" VerticalAlignment="Top">
            <StackPanel>
              <Border Classes="card-h">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Classes="sm" Content="Reiniciar" Command="{Binding RestartCommand}" IsEnabled="{Binding Running}"
                          ToolTip.Tip="Lo para limpio (vuelca los datos a disco) y lo arranca otra vez" ToolTip.ShowOnDisabled="True" />
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Classes="h2" Text="{Binding Version, StringFormat='Redis {0}'}" />
                    <ctl:Chip Text="{Binding HeaderChip}" Tone="{Binding HeaderTone}" ShowDot="True" />
                  </StackPanel>
                </DockPanel>
              </Border>
              <StackPanel Margin="16,14" Spacing="14">
                <ctl:Note Tone="Accent" IsVisible="{Binding NotInstalled}">
                  <StackPanel Spacing="8">
                    <TextBlock TextWrapping="Wrap"
                               Text="Redis aún no está instalado. Roost baja la build de redis-windows (Redis de verdad, compilado del código oficial), comprueba su SHA-256 y lo deja en bin\redis, solo en 127.0.0.1." />
                    <Button Classes="primary" HorizontalAlignment="Left" Content="Instalar Redis" Command="{Binding InstallCommand}" />
                  </StackPanel>
                </ctl:Note>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                  <CheckBox IsChecked="{Binding InStack}" VerticalAlignment="Center">
                    <StackPanel>
                      <TextBlock Classes="strong" Text="En el stack" />
                      <TextBlock Classes="faint" TextWrapping="Wrap" Text="Arranca con Iniciar todo, después de la base de datos. Cambiarlo rearranca el stack." />
                    </StackPanel>
                  </CheckBox>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <StackPanel Spacing="6">
                      <TextBlock Classes="lbl" Text="Puerto" />
                      <TextBox Classes="mono" Width="96" Text="{Binding PortText}" AutomationProperties.Name="Puerto de Redis" />
                      <ctl:Chip Text="{Binding PortChip}" Tone="{Binding PortTone}" />
                    </StackPanel>
                    <Button Classes="primary" Content="Aplicar" Command="{Binding ApplyPortCommand}" IsEnabled="{Binding CanApplyPort}" Margin="0,0,0,28" />
                  </StackPanel>
                </Grid>

                <ctl:Note Tone="{Binding PingTone}" IsVisible="{Binding HasPing}">
                  <TextBlock TextWrapping="Wrap">
                    <Run Text="{Binding PingText, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="{Binding Port, StringFormat=' · 127.0.0.1:{0}', Mode=OneWay}" />
                  </TextBlock>
                </ctl:Note>

                <StackPanel Spacing="6">
                  <TextBlock Classes="lbl" Text="Para tu .env (Laravel)" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <!-- Varias líneas: el campo crece con ellas (Height=NaN deshace el alto fijo de .field). -->
                    <Border Classes="field" Height="NaN" Padding="10,7">
                      <SelectableTextBlock Classes="mono" Text="{Binding EnvText}" TextWrapping="Wrap" />
                    </Border>
                    <Button Grid.Column="1" Classes="icon" VerticalAlignment="Top" Command="{Binding CopyEnvCommand}" ToolTip.Tip="Copiar" AutomationProperties.Name="Copiar las variables de Redis">
                      <ctl:Icon Data="{StaticResource IcCopy}" Size="15" />
                    </Button>
                  </Grid>
                  <TextBlock Classes="faint" TextWrapping="Wrap"
                             Text="Con predis (composer require predis/predis) no hace falta ninguna extensión de PHP. phpredis no viene en los PHP de windows.php.net." />
                </StackPanel>

                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="6">
                  <TextBlock Classes="muted" Text="Datos" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding DataPath}">
                    <Run Text="{Binding DataPath, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                    <Run Text="  (AOF: se pierde como mucho un segundo; Roost nunca lo borra)" Foreground="{DynamicResource FaintBrush}" FontSize="12" />
                  </TextBlock>
                  <Button Grid.Column="2" Classes="sm ghost" Content="Abrir carpeta" Command="{Binding OpenDataFolderCommand}" />

                  <TextBlock Grid.Row="1" Classes="muted" Text="Configuración" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="1" Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding ConfPath}">
                    <Run Text="{Binding ConfPath, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                    <Run Text="  (generada en cada arranque)" Foreground="{DynamicResource FaintBrush}" FontSize="12" />
                  </TextBlock>
                  <Button Grid.Row="1" Grid.Column="2" Classes="sm ghost" Content="Ver redis.conf" Command="{Binding OpenConfCommand}" />

                  <TextBlock Grid.Row="2" Classes="muted" Text="Mis ajustes" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="2" Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding UserConfPath}">
                    <Run Text="{Binding UserConfPath, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                    <Run Text="  (maxmemory, notify-keyspace-events…; Roost no lo toca)" Foreground="{DynamicResource FaintBrush}" FontSize="12" />
                  </TextBlock>
                  <Button Grid.Row="2" Grid.Column="2" Classes="sm ghost" Content="Editar mis ajustes" Command="{Binding EditUserConfCommand}" />

                  <TextBlock Grid.Row="3" Classes="muted" Text="Registro" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Classes="mono" FontSize="12" Text="logs\redis.log" VerticalAlignment="Center" />
                  <Button Grid.Row="3" Grid.Column="2" Classes="sm ghost" Content="Abrir" Command="{Binding GoLogCommand}" AutomationProperties.Name="Abrir el registro de Redis" />
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <StackPanel Grid.Column="1" Spacing="16">
            <!-- Disponibles -->
            <Border Classes="card">
              <StackPanel>
                <Border Classes="card-h">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Classes="h2" Text="Disponibles" />
                    <TextBlock Classes="hint" Text="redis-windows" />
                  </StackPanel>
                </Border>
                <Border Classes="tr" MinHeight="50" Padding="16,8">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <ctl:Dot Tone="Ok" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Classes="mono strong" Text="{Binding CatalogVersion}" />
                      <TextBlock Classes="faint" Text="build MSYS2 · SHA-256 fijado" ToolTip.Tip="{Binding CatalogSha}" />
                    </StackPanel>
                    <ctl:Chip Grid.Column="2" Text="instalada" IsVisible="{Binding Installed}" />
                    <Button Grid.Column="2" Classes="sm" Content="Instalar" Command="{Binding InstallCommand}" IsVisible="{Binding NotInstalled}"
                            AutomationProperties.Name="Instalar Redis" />
                  </Grid>
                </Border>
                <ctl:Note Tone="Accent" Margin="16,12"
                          Content="Redis no publica binarios para Windows. Este es Redis de verdad, compilado del código oficial en GitHub Actions públicas; Roost fija su versión y su SHA-256, y cada versión nueva llega con una actualización de Roost." />
              </StackPanel>
            </Border>

            <!-- Otros Redis del equipo (Memurai, un servicio de Windows) -->
            <Border Classes="card" IsVisible="{Binding HasOthers}">
              <StackPanel>
                <Border Classes="card-h">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Classes="h2" Text="Otros Redis en este equipo" />
                  </StackPanel>
                </Border>
                <StackPanel Margin="16,14" Spacing="10">
                  <ItemsControl ItemsSource="{Binding Others}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="sys:String">
                        <ctl:Note Tone="Warn"><TextBlock Text="{Binding}" TextWrapping="Wrap" /></ctl:Note>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Classes="sm" HorizontalAlignment="Left" Content="Abrir Servicios de Windows" Command="{Binding OpenServicesPanelCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
