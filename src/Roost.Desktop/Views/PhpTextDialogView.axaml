<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Roost.Desktop.ViewModels"
             xmlns:ctl="using:Roost.Desktop.Controls"
             x:Class="Roost.Desktop.Views.PhpTextDialogView"
             x:DataType="vm:PhpTextDialogViewModel">
  <Border Classes="modal wide" Width="720">
    <DockPanel>
      <Border DockPanel.Dock="Bottom" Classes="modal-f">
        <DockPanel>
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
            <Button Content="Copiar" Command="{Binding CopyCommand}" IsVisible="{Binding CanCopy}" IsEnabled="{Binding !Loading}"
                    ToolTip.Tip="Copia todo el texto, no solo lo filtrado" />
            <Button Content="Abrir carpeta" Command="{Binding OpenFolderCommand}" IsVisible="{Binding CanOpenFolder}" />
          </StackPanel>
          <Button Classes="primary" Content="Cerrar" Command="{Binding FinishCommand}" HorizontalAlignment="Right" />
        </DockPanel>
      </Border>
      <StackPanel Spacing="12" Margin="20,18,20,18">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Border Classes="badge-ic" Classes.bad="{Binding HasError}">
            <ctl:Icon Data="{StaticResource IcFile}" Size="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Classes="h3" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="faint" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Subtitle}" />
          </StackPanel>
        </Grid>

        <TextBlock Classes="mono" Text="{Binding Path}" IsVisible="{Binding HasPath}" FontSize="12" TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding Path}" />

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <TextBox Text="{Binding Query}" PlaceholderText="Buscar (xdebug, memory_limit, curl…)" MinHeight="32" Height="32"
                   AutomationProperties.Name="Buscar en el texto">
            <TextBox.InnerLeftContent>
              <ctl:Icon Data="{StaticResource IcSearch}" Size="14" Margin="8,0,0,0" VerticalAlignment="Center" />
            </TextBox.InnerLeftContent>
          </TextBox>
          <TextBlock Grid.Column="1" Classes="faint" Text="{Binding CountText}" VerticalAlignment="Center" />
        </Grid>

        <ctl:Note Tone="Bad" IsVisible="{Binding HasError}" Content="{Binding Error}" />
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding Loading}" AutomationProperties.Name="Cargando" />

        <Border Classes="log" Padding="12,10">
          <ScrollViewer Height="340" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Lines}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LogLine">
                  <TextBlock Classes="logline" Classes.e="{Binding IsError}" Classes.w="{Binding IsWarn}" Classes.m="{Binding IsMuted}"
                             Text="{Binding Text}" TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <TextBlock Classes="faint" Text="{Binding Footnote}" IsVisible="{Binding HasFootnote}" TextWrapping="Wrap" />
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
