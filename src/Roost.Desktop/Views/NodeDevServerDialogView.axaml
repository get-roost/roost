<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Roost.Desktop.ViewModels"
             xmlns:ctl="using:Roost.Desktop.Controls"
             x:Class="Roost.Desktop.Views.NodeDevServerDialogView"
             x:DataType="vm:NodeDevServerDialogViewModel">
  <Border Classes="modal wide" Width="720">
    <DockPanel>
      <Border DockPanel.Dock="Bottom" Classes="modal-f">
        <DockPanel>
          <Button DockPanel.Dock="Left" Content="Copiar la salida" Command="{Binding CopyCommand}" IsVisible="{Binding CanCopy}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Command="{Binding OpenCommand}" IsVisible="{Binding Session.CanOpen}" ToolTip.Tip="{Binding Session.Url}"
                    AutomationProperties.Name="Abrir en el navegador">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ctl:Icon Data="{StaticResource IcExternal}" Size="14" VerticalAlignment="Center" />
                <TextBlock Text="Abrir" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="danger" Content="Parar" Command="{Binding StopCommand}" IsVisible="{Binding Session.Running}"
                    ToolTip.Tip="Termina el proceso y todo lo que haya lanzado" />
            <Button Classes="primary" Content="Dejar en marcha" Command="{Binding FinishCommand}" IsVisible="{Binding Session.Running}"
                    ToolTip.Tip="Cierra esta ventana; sigue en marcha y se para desde el panel del sitio" />
            <Button Classes="primary" Content="Cerrar" Command="{Binding FinishCommand}" IsVisible="{Binding Session.Done}" />
          </StackPanel>
        </DockPanel>
      </Border>
      <StackPanel Spacing="12" Margin="20,18,20,18">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Border Classes="badge-ic">
            <ctl:Icon Data="{StaticResource IcNode}" Size="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Classes="h3" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="faint" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Subtitle}" />
          </StackPanel>
        </Grid>

        <StackPanel Spacing="6">
          <DockPanel>
            <ctl:Chip DockPanel.Dock="Right" Text="en marcha" Tone="Ok" ShowDot="True" IsVisible="{Binding Session.Running}" />
            <TextBlock Classes="mono strong" Text="{Binding Session.StatusText}" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding Session.Folder}" VerticalAlignment="Center" />
          </DockPanel>
          <ProgressBar IsIndeterminate="{Binding Session.Running}" IsVisible="{Binding Session.Running}" AutomationProperties.Name="En marcha" />
        </StackPanel>

        <Border Classes="log" Padding="12,10">
          <ScrollViewer Name="OutputScroll" Height="280" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Session.Lines}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LogLine">
                  <TextBlock Classes="logline" Classes.e="{Binding IsError}" Classes.w="{Binding IsWarn}" Classes.m="{Binding IsMuted}"
                             Text="{Binding Text}" TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <ctl:Note Tone="Warn" IsVisible="{Binding Session.HasUrlWarning}" Content="{Binding Session.UrlWarning}" />
        <ctl:Note Tone="{Binding Session.ResultTone}" Content="{Binding Session.ResultText}" />
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
