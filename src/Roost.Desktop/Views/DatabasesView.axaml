<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Roost.Desktop.ViewModels"
             xmlns:ctl="using:Roost.Desktop.Controls"
             xmlns:svc="using:Roost.Desktop.Services"
             xmlns:sys="using:System"
             x:Class="Roost.Desktop.Views.DatabasesView"
             x:DataType="vm:DatabasesViewModel">
  <ScrollViewer>
    <StackPanel>
      <Grid ColumnDefinitions="*,Auto" Margin="24,18,24,14">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Classes="h1" Text="Bases de datos" />
          <TextBlock Classes="sub" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button Grid.Column="1" Content="Consola SQL" Command="{Binding OpenConsoleCommand}" CommandParameter="{x:Null}" IsEnabled="{Binding DbRunning}" />
      </Grid>

      <StackPanel Margin="24,0,24,24" Spacing="16">
        <ctl:Note Tone="Accent" IsVisible="{Binding IsInstalling}">
          <TextBlock Text="{Binding Installing, StringFormat='Instalando en segundo plano: {0}'}" />
        </ctl:Note>

        <Grid ColumnDefinitions="*,340" ColumnSpacing="16">
          <!-- La global: conexión, puerto, contraseña, ficheros -->
          <Border Classes="card" VerticalAlignment="Top">
            <StackPanel>
              <Border Classes="card-h">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button Classes="sm" Content="Reiniciar" Command="{Binding RestartCommand}" IsEnabled="{Binding DbRunning}" />
                    <!-- Parar e Iniciar de verdad (roost stop / start): PHP y el servidor web siguen; la configuración no cambia. -->
                    <Button Classes="sm" Content="Parar" Command="{Binding StopCommand}" IsVisible="{Binding !CanStartDb}" IsEnabled="{Binding DbRunning}"
                            ToolTip.Tip="Para solo la base de datos, limpia; PHP y el servidor web siguen (roost stop)" />
                    <Button Classes="sm primary" Content="Iniciar" Command="{Binding StartCommand}" IsVisible="{Binding CanStartDb}"
                            ToolTip.Tip="Vuelve a arrancar la base de datos (roost start)" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Classes="h2" Text="{Binding HeaderTitle}" />
                    <ctl:Chip Text="{Binding HeaderChip}" Tone="{Binding HeaderTone}" ShowDot="True" />
                  </StackPanel>
                </DockPanel>
              </Border>
              <ctl:Note Tone="Warn" Margin="16,14" IsVisible="{Binding !HasGlobal}"
                        Content="No hay base de datos global. Instala una de la lista de disponibles y pulsa Usar." />
              <StackPanel Margin="16,14" Spacing="14" IsVisible="{Binding HasGlobal}">
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="lbl" Text="Host" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                      <Border Classes="field"><TextBlock Classes="mono" Text="127.0.0.1" /></Border>
                      <Button Grid.Column="1" Classes="icon" Command="{Binding CopyCommand}" CommandParameter="127.0.0.1" ToolTip.Tip="Copiar" AutomationProperties.Name="Copiar host">
                        <ctl:Icon Data="{StaticResource IcCopy}" Size="15" />
                      </Button>
                    </Grid>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Classes="lbl" Text="Puerto" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                      <TextBox Classes="mono" Text="{Binding PortText}" AutomationProperties.Name="Puerto de la base de datos" />
                      <Button Grid.Column="1" Classes="icon" Command="{Binding CopyCommand}" CommandParameter="{Binding Port, Converter={x:Static ctl:ValueConverters.ToText}}"
                              ToolTip.Tip="Copiar" AutomationProperties.Name="Copiar puerto">
                        <ctl:Icon Data="{StaticResource IcCopy}" Size="15" />
                      </Button>
                      <Button Grid.Column="2" Classes="primary" Content="Aplicar" Command="{Binding ApplyPortCommand}" IsEnabled="{Binding CanApplyPort}"
                              ToolTip.Tip="Guarda el puerto y rearranca la base de datos" ToolTip.ShowOnDisabled="True" />
                    </Grid>
                  </StackPanel>
                  <StackPanel Grid.Row="1" Spacing="6">
                    <TextBlock Classes="lbl" Text="Usuario" />
                    <Border Classes="field"><TextBlock Classes="mono" Text="root" /></Border>
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                    <TextBlock Classes="lbl" Text="Contraseña" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                      <Border Classes="field">
                        <TextBlock Classes="mono" Text="{Binding PasswordMask}" Classes.muted="{Binding !HasPassword}" />
                      </Border>
                      <Button Grid.Column="1" Classes="icon" Command="{Binding CopyPasswordCommand}" IsEnabled="{Binding HasPassword}"
                              ToolTip.Tip="Copiar la contraseña" AutomationProperties.Name="Copiar contraseña">
                        <ctl:Icon Data="{StaticResource IcCopy}" Size="15" />
                      </Button>
                      <Button Grid.Column="2" Content="Cambiar…" Command="{Binding ChangePasswordCommand}" IsEnabled="{Binding DbRunning}"
                              ToolTip.Tip="{Binding ChangePasswordTip}" ToolTip.ShowOnDisabled="True" AutomationProperties.Name="Cambiar la contraseña de root" />
                    </Grid>
                  </StackPanel>
                </Grid>

                <!-- Estado del puerto tecleado, en vivo -->
                <ctl:Note Tone="{Binding PortTone}">
                  <StackPanel Spacing="6">
                    <TextBlock TextWrapping="Wrap">
                      <Run Text="{Binding PortTitle, Mode=OneWay}" FontWeight="SemiBold" />
                      <Run Text="{Binding PortDetail, Mode=OneWay}" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasSuggestions}">
                      <TextBlock Classes="faint" Text="Libres:" VerticalAlignment="Center" />
                      <ItemsControl ItemsSource="{Binding Suggestions}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="sys:Int32">
                            <Button Classes="sm mono" Content="{Binding}"
                                    Command="{Binding $parent[ItemsControl].((vm:DatabasesViewModel)DataContext).UseSuggestionCommand}" CommandParameter="{Binding}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                    <TextBlock Classes="faint" TextWrapping="Wrap" IsVisible="{Binding CanApplyPort}"
                               Text="Cambiarlo rearranca la base de datos. Acuérdate del DB_PORT de tus proyectos." />
                  </StackPanel>
                </ctl:Note>

                <StackPanel Spacing="6">
                  <TextBlock Classes="lbl" Text="Para tu .env" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <Border Classes="field"><TextBlock Classes="mono" Text="{Binding EnvLine}" TextTrimming="CharacterEllipsis" /></Border>
                    <Button Grid.Column="1" Classes="icon" Command="{Binding CopyCommand}" CommandParameter="{Binding EnvLine}" ToolTip.Tip="Copiar" AutomationProperties.Name="Copiar variables">
                      <ctl:Icon Data="{StaticResource IcCopy}" Size="15" />
                    </Button>
                  </Grid>
                </StackPanel>

                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="6">
                  <TextBlock Classes="muted" Text="Datos" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding DataPath}">
                    <Run Text="{Binding DataPath, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                    <Run Text="  (los usa cualquier versión de esa rama)" Foreground="{DynamicResource FaintBrush}" FontSize="12" />
                  </TextBlock>
                  <Button Grid.Column="2" Classes="sm ghost" Content="Abrir carpeta" Command="{Binding OpenDataFolderCommand}" />

                  <TextBlock Grid.Row="1" Classes="muted" Text="Configuración" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="1" Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding IniPath}">
                    <Run Text="{Binding IniPath, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                    <Run Text="  (generado en cada arranque)" Foreground="{DynamicResource FaintBrush}" FontSize="12" />
                  </TextBlock>
                  <Button Grid.Row="1" Grid.Column="2" Classes="sm ghost" Content="Ver my.ini" Command="{Binding OpenIniCommand}" />

                  <TextBlock Grid.Row="2" Classes="muted" Text="Mis ajustes" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="2" Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding UserFilePath}">
                    <Run Text="{Binding UserFilePath, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                    <Run Text="  (sql_mode, max_allowed_packet…; Roost no lo toca)" Foreground="{DynamicResource FaintBrush}" FontSize="12" />
                  </TextBlock>
                  <Button Grid.Row="2" Grid.Column="2" Classes="sm ghost" Content="Editar mis ajustes" Command="{Binding EditUserFileCommand}" />
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <StackPanel Grid.Column="1" Spacing="16">
            <!-- Adminer (siempre: lo instala Roost) y los clientes gráficos del equipo que haya -->
            <Border Classes="card">
              <StackPanel>
                <Border Classes="card-h">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Classes="h2" Text="Abrir con" />
                    <TextBlock Classes="hint" Text="Adminer y programas de este equipo" />
                  </StackPanel>
                </Border>
                <StackPanel Margin="16,14" Spacing="8">
                  <!-- Servicios (oleada 3): Adminer en http://localhost/adminer -->
                  <Button HorizontalAlignment="Stretch" Content="Abrir Adminer" Command="{Binding OpenAdminerCommand}"
                          ToolTip.Tip="{Binding AdminerTip}" ToolTip.ShowOnDisabled="True" IsEnabled="{Binding DbRunning}"
                          AutomationProperties.Name="Abrir Adminer" />
                  <ItemsControl ItemsSource="{Binding Clients}" IsVisible="{Binding HasClients}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="svc:DbClient">
                        <Button HorizontalAlignment="Stretch" Content="{Binding ButtonLabel}" ToolTip.Tip="{Binding Tip}" ToolTip.ShowOnDisabled="True"
                                Command="{Binding $parent[ItemsControl].((vm:DatabasesViewModel)DataContext).OpenClientCommand}" CommandParameter="{Binding}"
                                IsEnabled="{Binding $parent[ItemsControl].((vm:DatabasesViewModel)DataContext).DbRunning}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="faint" TextWrapping="Wrap" Text="Entran como root, con la contraseña que guarda Roost. Adminer sale con root puesto: si tiene contraseña, cópiala de la izquierda." />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Puertos de base de datos ocupados en la máquina -->
            <Border Classes="card">
              <StackPanel>
                <Border Classes="card-h">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Classes="h2" Text="Puertos en este equipo" />
                    <TextBlock Classes="hint" Text="los habituales de MySQL" />
                  </StackPanel>
                </Border>
                <StackPanel Margin="16,14" Spacing="8">
                  <ItemsControl ItemsSource="{Binding BusyPorts}" IsVisible="{Binding HasBusyPorts}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:BusyPortLine">
                        <TextBlock Classes="small" Margin="0,2">
                          <Run Text="{Binding Port, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                          <Run Text="{Binding Owner, StringFormat=' · {0}', Mode=OneWay}" />
                        </TextBlock>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !HasBusyPorts}"
                             Text="Ninguno de los habituales (3306 a 3310, 33060) está ocupado." />
                  <TextBlock Classes="faint" TextWrapping="Wrap"
                             Text="Roost solo escucha en 127.0.0.1. Si el 3306 lo tiene otro MySQL o MariaDB, pon otro puerto en la conexión." />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="*,340" ColumnSpacing="16">
          <!-- Instaladas -->
          <Border Classes="card" VerticalAlignment="Top">
            <StackPanel>
              <Border Classes="card-h">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Classes="h2" Text="Instaladas por Roost" />
                  <TextBlock Classes="hint" Text="Una carpeta por versión, los datos aparte por rama" />
                </StackPanel>
              </Border>
              <Border Classes="th">
                <Grid ColumnDefinitions="80,76,*,118,140">
                  <TextBlock Text="Motor" />
                  <TextBlock Grid.Column="1" Text="Versión" />
                  <TextBlock Grid.Column="2" Text="Soporte" />
                  <TextBlock Grid.Column="3" Text="Datos" />
                  <TextBlock Grid.Column="4" Text="Acciones" HorizontalAlignment="Right" />
                </Grid>
              </Border>
              <TextBlock Classes="muted" Margin="16,12" Text="Ninguna todavía." IsVisible="{Binding !HasInstalled}" />
              <ItemsControl ItemsSource="{Binding Installed}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DbRow">
                    <Border Classes="tr" Classes.sel="{Binding InUse}">
                      <Grid ColumnDefinitions="80,76,*,118,140">
                        <TextBlock Classes="strong" Text="{Binding Engine}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Version}" VerticalAlignment="Center" />
                        <ctl:Chip Grid.Column="2" Text="{Binding Support}" Tone="{Binding SupportTone}" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="3" Classes="mono" FontSize="11.5" Text="{Binding Data}" VerticalAlignment="Center" />
                        <ctl:Chip Grid.Column="4" Text="en uso" Tone="Accent" HorizontalAlignment="Right" IsVisible="{Binding InUse}" />
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" IsVisible="{Binding NotInUse}">
                          <Button Classes="sm" Content="Usar" ToolTip.Tip="{Binding UseTip}"
                                  Command="{Binding $parent[ItemsControl].((vm:DatabasesViewModel)DataContext).UseCommand}" CommandParameter="{Binding}"
                                  AutomationProperties.Name="{Binding Version, StringFormat='Usar {0}'}" />
                          <Button Classes="sm ghost danger" Content="Quitar"
                                  Command="{Binding $parent[ItemsControl].((vm:DatabasesViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}"
                                  AutomationProperties.Name="{Binding Version, StringFormat='Quitar {0}'}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Classes="card-b" BorderBrush="{DynamicResource Line2Brush}" BorderThickness="0,1,0,0" IsVisible="{Binding HasExternal}">
                <StackPanel Spacing="6">
                  <TextBlock Classes="lbl" Text="Fuera de Roost" />
                  <ItemsControl ItemsSource="{Binding External}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ExternalDbRow">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <ctl:Chip Text="{Binding Chip}" Tone="{Binding Tone}" />
                          <TextBlock Classes="small" Text="{Binding Label}" VerticalAlignment="Center" />
                          <TextBlock Classes="mono faint" FontSize="11.5" Text="{Binding Where}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- Disponibles -->
          <Border Grid.Column="1" Classes="card" VerticalAlignment="Top">
            <StackPanel>
              <Border Classes="card-h">
                <TextBlock Classes="h2" Text="Disponibles" />
              </Border>
              <Border Classes="seg" Margin="16,14,16,6">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <RadioButton Theme="{StaticResource SegButton}" GroupName="db-engine" Content="MariaDB" IsChecked="{Binding ShowMariaDb}" />
                  <RadioButton Theme="{StaticResource SegButton}" GroupName="db-engine" Content="MySQL" IsChecked="{Binding ShowMySql}" />
                </StackPanel>
              </Border>
              <ctl:Note Tone="Bad" Margin="16,6,16,10" IsVisible="{Binding HasCatalogError}" Content="{Binding CatalogError}" />
              <ItemsControl ItemsSource="{Binding Catalog}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DbCatalogRow">
                    <Border Classes="tr" BorderThickness="0,1,0,0" MinHeight="50" Padding="16,8">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <ctl:Dot Tone="{Binding Tone}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Classes="mono strong" Text="{Binding Version}" />
                          <TextBlock Classes="faint" Text="{Binding Support}" />
                        </StackPanel>
                        <ctl:Chip Grid.Column="2" Text="instalada" IsVisible="{Binding Installed}" />
                        <Button Grid.Column="2" Classes="sm" Content="Instalar" IsVisible="{Binding Installable}"
                                Command="{Binding $parent[ItemsControl].((vm:DatabasesViewModel)DataContext).InstallCommand}" CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Build.Label, StringFormat='Instalar {0}'}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border BorderBrush="{DynamicResource Line2Brush}" BorderThickness="0,1,0,0" Padding="16,10">
                <TextBlock Classes="faint" Text="{Binding CatalogSource}" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Bases de datos del servidor -->
        <Border Classes="card" IsVisible="{Binding HasGlobal}">
          <StackPanel>
            <Border Classes="card-h">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                  <Button Classes="sm icon ghost" Command="{Binding RefreshCommand}" IsEnabled="{Binding DbRunning}"
                          ToolTip.Tip="Volver a leer las bases de datos y los usuarios" AutomationProperties.Name="Actualizar">
                    <ctl:Icon Data="{StaticResource IcRestart}" Size="15" />
                  </Button>
                  <!-- BD-2: importar un .sql, .sql.gz o .zip -->
                  <Button Classes="sm" Command="{Binding ImportCommand}" CommandParameter="{x:Null}" IsEnabled="{Binding DbRunning}"
                          ToolTip.Tip="Importa un .sql, .sql.gz o .zip en una base de datos nueva o en una que ya existe" ToolTip.ShowOnDisabled="True"
                          AutomationProperties.Name="Importar un volcado">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <ctl:Icon Data="{StaticResource IcUpload}" Size="14" />
                      <TextBlock Text="Importar…" />
                    </StackPanel>
                  </Button>
                  <TextBlock Classes="lbl" Text="Nueva" VerticalAlignment="Center" Margin="8,0,0,0" />
                  <TextBox Classes="mono" Width="160" MinHeight="30" Height="30" PlaceholderText="nombre" Text="{Binding NewDatabase}"
                           AutomationProperties.Name="Nombre de la base de datos nueva" />
                  <Button Classes="sm primary" Content="Crear (utf8mb4)" Command="{Binding CreateDatabaseCommand}" IsEnabled="{Binding DbRunning}" />
                </StackPanel>
                <TextBlock Classes="h2" Text="{Binding DatabasesTitle}" />
              </DockPanel>
            </Border>
            <ctl:Note Tone="Neutral" Margin="16,12" IsVisible="{Binding HasDatabasesError}" Content="{Binding DatabasesError}" />
            <ItemsControl ItemsSource="{Binding Databases}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DatabaseLine">
                  <Border Classes="tr" MinHeight="42" Padding="16,6">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                      <TextBlock Classes="mono strong" Text="{Binding Name}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="faint" Text="{Binding UsedBy}" VerticalAlignment="Center" IsVisible="{Binding HasUsedBy}" />
                      <Button Grid.Column="2" Classes="sm ghost" Content="Consola"
                              Command="{Binding $parent[ItemsControl].((vm:DatabasesViewModel)DataContext).OpenConsoleCommand}" CommandParameter="{Binding Name}" />
                      <!-- BD-2 -->
                      <Button Grid.Column="3" Classes="sm ghost" Content="Exportar…" ToolTip.Tip="Guarda un .sql (o .sql.gz) con sus tablas, vistas, rutinas, triggers y eventos"
                              Command="{Binding $parent[ItemsControl].((vm:DatabasesViewModel)DataContext).ExportCommand}" CommandParameter="{Binding}"
                              AutomationProperties.Name="{Binding Name, StringFormat='Exportar {0}'}" />
                      <Button Grid.Column="4" Classes="sm ghost danger" Content="Borrar"
                              Command="{Binding $parent[ItemsControl].((vm:DatabasesViewModel)DataContext).DropDatabaseCommand}" CommandParameter="{Binding}"
                              AutomationProperties.Name="{Binding Name, StringFormat='Borrar {0}'}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="muted" Margin="16,12" Text="Aún no hay bases de datos tuyas: crea una con su nombre."
                       IsVisible="{Binding ShowEmptyDatabases}" />
          </StackPanel>
        </Border>

        <!-- Usuarios del servidor -->
        <Border Classes="card" IsVisible="{Binding HasGlobal}">
          <StackPanel>
            <Border Classes="card-h">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="sm primary" Content="Nuevo usuario" Command="{Binding NewUserCommand}" CommandParameter="{x:Null}" IsEnabled="{Binding DbRunning}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Classes="h2" Text="Usuarios" />
                  <TextBlock Classes="hint" Text="uno por proyecto, con acceso solo a su base de datos" />
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Classes="th" IsVisible="{Binding HasUsers}">
              <Grid ColumnDefinitions="160,110,*,220">
                <TextBlock Text="Usuario" />
                <TextBlock Grid.Column="1" Text="Host" />
                <TextBlock Grid.Column="2" Text="Acceso a" />
                <TextBlock Grid.Column="3" Text="Acciones" HorizontalAlignment="Right" />
              </Grid>
            </Border>
            <ctl:Note Tone="Neutral" Margin="16,12" IsVisible="{Binding HasUsersError}" Content="{Binding UsersError}" />
            <ItemsControl ItemsSource="{Binding Users}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DbUserRow">
                  <Border Classes="tr" MinHeight="42" Padding="16,6">
                    <Grid ColumnDefinitions="160,110,*,220" ColumnSpacing="10">
                      <TextBlock Classes="mono strong" Text="{Binding Name}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Host}" VerticalAlignment="Center" />
                      <ctl:Chip Grid.Column="2" Text="{Binding Access}" Tone="{Binding AccessTone}" HorizontalAlignment="Left" />
                      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                        <Button Classes="sm ghost" Content="Cambiar contraseña"
                                Command="{Binding $parent[ItemsControl].((vm:DatabasesViewModel)DataContext).ChangeUserPasswordCommand}" CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Name, StringFormat='Cambiar la contraseña de {0}'}" />
                        <Button Classes="sm ghost danger" Content="Borrar"
                                Command="{Binding $parent[ItemsControl].((vm:DatabasesViewModel)DataContext).DropUserCommand}" CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Name, StringFormat='Borrar el usuario {0}'}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="muted" Margin="16,12" Text="Ningún usuario aparte de root. Crea uno por proyecto, con acceso solo a su base de datos."
                       IsVisible="{Binding ShowEmptyUsers}" />
            <Border BorderBrush="{DynamicResource Line2Brush}" BorderThickness="0,1,0,0" Padding="16,10">
              <TextBlock Classes="faint" TextWrapping="Wrap"
                         Text="root no sale aquí: su contraseña se cambia arriba, en la conexión. Los usuarios se crean como 'usuario'@'%', que vale porque el servidor solo escucha en este equipo." />
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
