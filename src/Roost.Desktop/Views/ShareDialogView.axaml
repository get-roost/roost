<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Roost.Desktop.ViewModels"
             xmlns:ctl="using:Roost.Desktop.Controls"
             x:Class="Roost.Desktop.Views.ShareDialogView"
             x:DataType="vm:ShareDialogViewModel">
  <!-- Compartir: los avisos antes de publicar un sitio por internet o en la red local -->
  <Border Classes="modal" Width="560">
    <DockPanel>
      <Border DockPanel.Dock="Bottom" Classes="modal-f">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Cancelar" Command="{Binding CancelCommand}" />
          <Button Classes="primary" Content="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}" />
        </StackPanel>
      </Border>
      <StackPanel Spacing="12" Margin="20,18,20,18">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Border Classes="badge-ic warn">
            <ctl:Icon Data="{StaticResource IcShare}" Size="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Classes="h3" Text="{Binding Title}" TextWrapping="Wrap" />
            <TextBlock Classes="faint" Text="{Binding Subtitle}" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
        <Border Background="{DynamicResource WinBrush}" CornerRadius="8" Padding="12,8" IsVisible="{Binding HasDetail}">
          <SelectableTextBlock Classes="mono" Text="{Binding Detail}" TextWrapping="Wrap" />
        </Border>
        <ItemsControl ItemsSource="{Binding Warnings}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ShareWarning">
              <ctl:Note Tone="{Binding Tone}">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
              </ctl:Note>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
