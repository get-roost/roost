<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Roost.Desktop.ViewModels"
             xmlns:ctl="using:Roost.Desktop.Controls"
             x:Class="Roost.Desktop.Views.SitesView"
             x:DataType="vm:SitesViewModel">
  <ScrollViewer>
    <StackPanel>
      <Grid ColumnDefinitions="*,Auto" Margin="24,18,24,14">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Classes="h1" Text="Sitios" />
          <TextBlock Classes="sub" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <!-- Sitios avanzados (C3): aparcar una carpeta, como el valet park de Valet -->
          <Button Command="{Binding ParkFolderCommand}" AutomationProperties.Name="Aparcar carpeta…"
                  ToolTip.Tip="Cada subcarpeta de la carpeta elegida será un sitio &lt;subcarpeta&gt;.test; las nuevas entran solas">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ctl:Icon Data="{StaticResource IcFolder}" Size="15" VerticalAlignment="Center" />
              <TextBlock Text="Aparcar carpeta…" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <!-- Git-app: un sitio desde un repositorio git -->
          <Button Command="{Binding FromGitCommand}" AutomationProperties.Name="Desde git…" ToolTip.Tip="Clonar un repositorio de GitHub, GitLab, Bitbucket o tu servidor como sitio nuevo">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ctl:Icon Data="{StaticResource IcGitBranch}" Size="15" VerticalAlignment="Center" />
              <TextBlock Text="Desde git…" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="primary" Command="{Binding NewSiteCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ctl:Icon Data="{StaticResource IcPlus}" Size="15" StrokeThickness="2" VerticalAlignment="Center" />
              <TextBlock Text="Nuevo sitio" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <Grid Margin="24,0,24,24" ColumnDefinitions="*,360" ColumnSpacing="16">
        <!-- Lista -->
        <StackPanel Spacing="16" VerticalAlignment="Top">
        <!-- Sitios avanzados: lo que falta en el hosts, junto (un solo permiso), y los avisos de .roost.toml y aparcadas -->
        <ctl:Note Tone="Warn" IsVisible="{Binding HasHostsPending}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="sm" Content="Añadir al hosts" Command="{Binding SyncHostsCommand}" VerticalAlignment="Center" Margin="12,0,0,0"
                    ToolTip.Tip="Todos de una vez: Windows pide permiso de administrador una sola vez" />
            <TextBlock TextWrapping="Wrap" Text="{Binding HostsPending}" VerticalAlignment="Center" />
          </DockPanel>
        </ctl:Note>
        <ctl:Note Tone="Warn" IsVisible="{Binding HasSourcesWarning}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="sm ghost" Content="Entendido" Command="{Binding DismissSourcesWarningCommand}" VerticalAlignment="Top" Margin="12,0,0,0" />
            <TextBlock TextWrapping="Wrap" Text="{Binding SourcesWarning}" />
          </DockPanel>
        </ctl:Note>
        <Border Classes="card" VerticalAlignment="Top">
          <StackPanel>
            <Border Classes="card-h">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="lbl" Text="Buscar" VerticalAlignment="Center" />
                  <TextBox Width="180" MinHeight="30" Height="30" PlaceholderText="nombre o carpeta" Text="{Binding Search}" AutomationProperties.Name="Buscar sitios" />
                </StackPanel>
                <TextBlock Classes="h2" Text="{Binding Count}" />
              </DockPanel>
            </Border>
            <Border Classes="th">
              <Grid ColumnDefinitions="2*,*,1.4*,76,64" ColumnSpacing="12">
                <TextBlock Text="Sitio" />
                <TextBlock Grid.Column="1" Text="PHP" />
                <TextBlock Grid.Column="2" Text="Certificado" />
                <TextBlock Grid.Column="3" Text="Git" />
                <TextBlock Grid.Column="4" Text="hosts" />
              </Grid>
            </Border>
            <ctl:Note Tone="Accent" Margin="16,14" IsVisible="{Binding !HasSites}"
                      Content="Aún no hay sitios. Pulsa Nuevo sitio para una carpeta o una plantilla, o Desde git… para un repositorio: cada uno se sirve en https://&lt;nombre&gt;.test con su propio certificado." />
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SiteRow">
                  <Button Classes="row" Classes.sel="{Binding IsSelected}"
                          Command="{Binding $parent[ItemsControl].((vm:SitesViewModel)DataContext).ChooseCommand}" CommandParameter="{Binding}"
                          AutomationProperties.Name="{Binding Host}">
                    <Border Classes="tr" Padding="16,10">
                      <Grid ColumnDefinitions="2*,*,1.4*,76,64" ColumnSpacing="12">
                        <StackPanel VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="mono strong" Text="{Binding Host}" VerticalAlignment="Center" />
                            <ctl:Chip Text="aparcado" Tone="Neutral" IsVisible="{Binding IsParked}" ToolTip.Tip="Sale de una carpeta aparcada" />
                          </StackPanel>
                          <TextBlock Classes="faint" Text="{Binding DocumentRoot}" TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding DocumentRoot}" />
                        </StackPanel>
                        <ctl:Chip Grid.Column="1" Text="{Binding Php}" Tone="{Binding PhpTone}" />
                        <ctl:Chip Grid.Column="2" Text="{Binding Cert}" Tone="{Binding CertTone}" />
                        <ctl:Chip Grid.Column="3" Text="{Binding GitChip}" Tone="{Binding GitTone}" ToolTip.Tip="{Binding GitTip}" />
                        <ctl:Chip Grid.Column="4" Text="{Binding Hosts}" Tone="{Binding HostsTone}" />
                      </Grid>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Sitios avanzados (C3): las carpetas aparcadas -->
        <Border Classes="card" VerticalAlignment="Top" IsVisible="{Binding HasParked}">
          <StackPanel>
            <Border Classes="card-h">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ctl:Icon Data="{StaticResource IcFolder}" Size="15" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Classes="h2" Text="Carpetas aparcadas" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding ParkedRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ParkedRow">
                  <Border Classes="tr" Padding="16,10">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                      <TextBlock Classes="mono" Text="{Binding Folder}" TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding Folder}" VerticalAlignment="Center" />
                      <ctl:Chip Grid.Column="1" Text="{Binding Detail}" Tone="{Binding Tone}" />
                      <Button Grid.Column="2" Classes="sm ghost" Content="Dejar de aparcar"
                              Command="{Binding $parent[ItemsControl].((vm:SitesViewModel)DataContext).UnparkCommand}" CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="faint" Margin="16,8,16,12" TextWrapping="Wrap"
                       Text="Cada subcarpeta es un sitio &lt;subcarpeta&gt;.test. Con la app abierta (o el stack en marcha), una carpeta nueva da un sitio nuevo y una borrada lo quita; las que tienen un nombre que no vale se saltan y se dice." />
          </StackPanel>
        </Border>
        </StackPanel>

        <!-- Detalle -->
        <Border Grid.Column="1" Classes="card" VerticalAlignment="Top" IsVisible="{Binding HasSelection}">
          <StackPanel>
            <Border Classes="card-h">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                  <!-- Sitios avanzados (C2): renombrar y mover -->
                  <Button Classes="sm" Content="Editar…" Command="{Binding EditCommand}" ToolTip.Tip="Cambiar el nombre o la carpeta del sitio" />
                  <Button Classes="sm" Content="Abrir" Command="{Binding OpenCommand}" />
                </StackPanel>
                <TextBlock Classes="h2 mono" Text="{Binding Selected.Host, FallbackValue=''}" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </Border>
            <StackPanel Margin="16,14" Spacing="14">
              <ctl:Note Tone="Warn" IsVisible="{Binding MissingFromHosts}">
                <StackPanel Spacing="6">
                  <TextBlock TextWrapping="Wrap" Text="Falta en el hosts: no resolverá hasta que se añada (Windows pide permiso de administrador)." />
                  <Button Classes="sm" Content="Añadir al hosts" HorizontalAlignment="Left" Command="{Binding SyncHostsCommand}" />
                </StackPanel>
              </ctl:Note>
              <ctl:Note Tone="Warn" IsVisible="{Binding HasPathWarning}">
                <TextBlock TextWrapping="Wrap" Text="{Binding PathWarning}" />
              </ctl:Note>
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="8">
                <TextBlock Classes="muted" Text="Direcciones" Margin="0,2,0,0" />
                <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <TextBlock Classes="mono" Text="{Binding Urls}" TextWrapping="Wrap" />
                  <Button Grid.Column="1" Classes="sm icon ghost" VerticalAlignment="Top" Command="{Binding CopyUrlCommand}"
                          ToolTip.Tip="Copiar la URL" AutomationProperties.Name="Copiar la URL">
                    <ctl:Icon Data="{StaticResource IcCopy}" Size="14" />
                  </Button>
                </Grid>
                <!-- Sitios avanzados (C7): alias y subdominios -->
                <TextBlock Grid.Row="1" Classes="muted" Text="Alias" Margin="0,2,0,0" />
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                  <TextBlock Classes="mono" Text="{Binding AliasesText}" TextWrapping="Wrap" IsVisible="{Binding HasAliases}" />
                  <TextBlock Classes="faint" Text="{Binding AliasesHint}" TextWrapping="Wrap" />
                  <Button Classes="sm" Content="Alias…" Command="{Binding AliasesCommand}" HorizontalAlignment="Left"
                          ToolTip.Tip="Otros nombres .test para este sitio, o subdominios con nombre (api.…)" />
                </StackPanel>
                <TextBlock Grid.Row="2" Classes="muted" Text="Carpeta" VerticalAlignment="Center" />
                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBlock Classes="mono" Text="{Binding Selected.Site.Folder, FallbackValue=''}" TextTrimming="LeadingCharacterEllipsis" VerticalAlignment="Center"
                               ToolTip.Tip="{Binding Selected.Site.Folder, FallbackValue=''}" />
                    <Button Grid.Column="1" Classes="sm icon ghost" Command="{Binding CopyPathCommand}"
                            ToolTip.Tip="Copiar la ruta" AutomationProperties.Name="Copiar la ruta">
                      <ctl:Icon Data="{StaticResource IcCopy}" Size="14" />
                    </Button>
                  </Grid>
                  <TextBlock Classes="faint" Text="{Binding ParkedText}" TextWrapping="Wrap" IsVisible="{Binding IsParkedSite}" />
                </StackPanel>
                <TextBlock Grid.Row="3" Classes="muted" Text="Raíz web" Margin="0,2,0,0" />
                <StackPanel Grid.Row="3" Grid.Column="1" Spacing="8">
                  <TextBlock Classes="mono" Text="{Binding RootText}" />
                  <WrapPanel ItemSpacing="6" LineSpacing="6">
                    <Button Classes="sm" Content="Cambiar…" Command="{Binding ChangeRootCommand}" IsEnabled="{Binding FolderExists}"
                            ToolTip.Tip="Elegir la subcarpeta del proyecto que se sirve" />
                    <Button Classes="sm" Content="Usar la carpeta del proyecto" Command="{Binding UseProjectRootCommand}" IsVisible="{Binding HasSubRoot}" />
                  </WrapPanel>
                  <StackPanel Spacing="4" IsVisible="{Binding HasRootChoices}">
                    <TextBlock Classes="faint" Text="También en el proyecto:" />
                    <ItemsControl ItemsSource="{Binding RootChoices}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RootChoice">
                          <Button Classes="chip" Content="{Binding Label}" ToolTip.Tip="Servir esta subcarpeta"
                                  Command="{Binding $parent[ItemsControl].((vm:SitesViewModel)DataContext).SetRootCommand}" CommandParameter="{Binding Root}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </Grid>
              <StackPanel Spacing="6">
                <TextBlock Classes="lbl" Text="PHP del sitio" />
                <ComboBox ItemsSource="{Binding PhpOptions}" SelectedItem="{Binding SelectedPhp}" HorizontalAlignment="Stretch" AutomationProperties.Name="PHP del sitio" />
                <TextBlock Classes="faint" TextWrapping="Wrap" Text="Se aplica sin cortar: Roost arranca el PHP de esa rama antes de mandarle nada. Cada rama en uso tiene su propio pool de php-cgi." />
              </StackPanel>

              <!-- Sitios avanzados (C11): el .roost.toml del proyecto -->
              <Border Background="{DynamicResource WinBrush}" CornerRadius="8" Padding="12,10">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <ctl:Icon Data="{StaticResource IcFile}" Size="15" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock Classes="lbl" Text=".roost.toml" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Classes="small" Text="{Binding ProjectFileText}" TextWrapping="Wrap" IsVisible="{Binding HasProjectFile}" />
                  <TextBlock Classes="faint" TextWrapping="Wrap" IsVisible="{Binding !HasProjectFile}"
                             Text="Guárdalo en la carpeta para versionar con el proyecto su PHP, su raíz web, su base de datos y sus alias: Roost lo lee al dar de alta el sitio, al iniciar y al abrir la app." />
                  <TextBlock Classes="faint" TextWrapping="Wrap" IsVisible="{Binding HasProjectFile}"
                             Text="Lo que cambies aquí se guarda también en él; lo que cambies en él se aplica al iniciar o al abrir la app." />
                  <WrapPanel ItemSpacing="6" LineSpacing="6" IsEnabled="{Binding FolderExists}">
                    <Button Classes="sm" Content="Guardar en .roost.toml" Command="{Binding SaveProjectFileCommand}"
                            ToolTip.Tip="PHP, raíz web, base de datos y alias del sitio, tal como están ahora" />
                    <Button Classes="sm" Content="Abrir" Command="{Binding OpenProjectFileCommand}" IsVisible="{Binding HasProjectFile}" />
                  </WrapPanel>
                </StackPanel>
              </Border>

              <!-- Git-app: el repositorio del sitio (maqueta F del diseño de git) -->
              <Border Background="{DynamicResource WinBrush}" CornerRadius="8" Padding="12,10" IsVisible="{Binding HasGit}">
                <StackPanel Spacing="8">
                  <DockPanel>
                    <ctl:Chip DockPanel.Dock="Right" Text="{Binding GitChipText}" Tone="{Binding GitChipTone}" ShowDot="True" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <ctl:Icon Data="{StaticResource IcGitBranch}" Size="15" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                      <TextBlock Classes="lbl" Text="Git" VerticalAlignment="Center" />
                    </StackPanel>
                  </DockPanel>
                  <ComboBox ItemsSource="{Binding GitBranches}" SelectedItem="{Binding GitBranch}" IsEnabled="{Binding GitCanBranch}" HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Rama del sitio" ToolTip.Tip="Cambiar de rama (solo con el árbol limpio)" ToolTip.ShowOnDisabled="True" />
                  <TextBlock Classes="faint" Text="{Binding GitRepoText}" TextWrapping="Wrap" />
                  <TextBlock Classes="small" TextWrapping="Wrap" IsVisible="{Binding HasGitCommit}">
                    <Run Text="{Binding GitCommitSha, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" />
                    <Run Text=" " />
                    <Run Text="{Binding GitCommitSubject, Mode=OneWay}" />
                    <Run Text=" " />
                    <Run Text="{Binding GitCommitMeta, Mode=OneWay}" Foreground="{DynamicResource FaintBrush}" FontSize="12" />
                  </TextBlock>
                  <ctl:Note Tone="{Binding GitNoteTone}" IsVisible="{Binding HasGitNote}">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{Binding GitNote}" TextWrapping="Wrap" />
                      <Button Classes="sm" Content="Terminal aquí" Command="{Binding OpenTerminalCommand}" IsVisible="{Binding GitDirty}" HorizontalAlignment="Left" />
                    </StackPanel>
                  </ctl:Note>
                  <WrapPanel ItemSpacing="6" LineSpacing="6">
                    <Button Classes="sm" Classes.primary="{Binding GitUpdatePrimary}" Content="Actualizar" Command="{Binding GitUpdateCommand}" IsEnabled="{Binding GitCanUpdate}"
                            ToolTip.Tip="git pull, solo fast-forward y solo con el árbol limpio" ToolTip.ShowOnDisabled="True" />
                    <Button Classes="sm" Content="Historial" Command="{Binding GitHistoryCommand}" ToolTip.Tip="Lo que Roost ha hecho con el repositorio" />
                    <Button Classes="sm" Classes.primary="{Binding GitAccessPrimary}" Content="Acceso…" Command="{Binding GitAccessCommand}" IsEnabled="{Binding GitIdle}"
                            ToolTip.Tip="Ver, cambiar o probar cómo entra el sitio en su repositorio" />
                    <Button Classes="sm" Classes.ghost="{Binding !GitShowCheckNow}" Content="Comprobar ahora" Command="{Binding GitCheckNowCommand}" IsEnabled="{Binding GitIdle}"
                            ToolTip.Tip="Trae lo nuevo del remoto (fetch) sin tocar la carpeta y cuenta los commits que faltan" />
                  </WrapPanel>
                  <TextBlock Classes="faint" Text="{Binding GitCheckHint}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <!-- Git-app: un .git que Roost no gestiona -->
              <Border Background="{DynamicResource WinBrush}" CornerRadius="8" Padding="12,10" IsVisible="{Binding GitDetected}">
                <StackPanel Spacing="8">
                  <DockPanel>
                    <ctl:Chip DockPanel.Dock="Right" Text="sin adoptar" Tone="Neutral" ShowDot="True" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <ctl:Icon Data="{StaticResource IcGitBranch}" Size="15" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                      <TextBlock Classes="lbl" Text="Git" VerticalAlignment="Center" />
                    </StackPanel>
                  </DockPanel>
                  <TextBlock Classes="small" Text="{Binding GitDetectedText}" TextWrapping="Wrap" />
                  <TextBlock Classes="faint" TextWrapping="Wrap"
                             Text="Roost puede seguir su remoto y su rama, y actualizarlo desde aquí. Entra con tu acceso (tus claves SSH o tu git): Roost no guarda credenciales." />
                  <Button Classes="sm" Content="Adoptar" Command="{Binding GitAdoptCommand}" HorizontalAlignment="Left" IsEnabled="{Binding GitIdle}" />
                </StackPanel>
              </Border>

              <!-- Composer: solo si la carpeta tiene composer.json -->
              <Border Background="{DynamicResource WinBrush}" CornerRadius="8" Padding="12,10" IsVisible="{Binding HasComposer}">
                <StackPanel Spacing="8">
                  <DockPanel>
                    <ctl:Chip DockPanel.Dock="Right" Text="{Binding ComposerChip}" Tone="{Binding ComposerChipTone}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <ctl:Icon Data="{StaticResource IcPackage}" Size="15" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                      <TextBlock Classes="lbl" Text="Composer" VerticalAlignment="Center" />
                      <ctl:Chip Text="{Binding FrameworkText}" Tone="Accent" IsVisible="{Binding HasFramework}" />
                    </StackPanel>
                  </DockPanel>
                  <TextBlock Classes="faint" Text="{Binding ComposerText}" TextWrapping="Wrap" />
                  <TextBlock Classes="small" TextWrapping="Wrap" Foreground="{DynamicResource WarnBrush}" IsVisible="{Binding ComposerNeedsInstall}"
                             Text="Tiene composer.json pero aún no vendor/: Instalar dependencias lo crea." />
                  <WrapPanel ItemSpacing="6" LineSpacing="6" IsEnabled="{Binding ComposerIdle}">
                    <Button Classes="sm" Classes.primary="{Binding ComposerNeedsInstall}" Content="Instalar dependencias" Command="{Binding ComposerInstallCommand}"
                            ToolTip.Tip="composer install: lo que fija el composer.lock" />
                    <Button Classes="sm" Content="Actualizar" Command="{Binding ComposerUpdateCommand}"
                            ToolTip.Tip="composer update: lo más nuevo que permite el composer.json (reescribe el composer.lock)" />
                    <Button Classes="sm" Content="Añadir paquete…" Command="{Binding ComposerRequireCommand}" ToolTip.Tip="composer require vendor/paquete" />
                  </WrapPanel>
                  <TextBlock Classes="faint" TextWrapping="Wrap"
                             Text="Composer ejecuta los scripts del composer.json del proyecto: úsalo con proyectos en los que confíes." />
                </StackPanel>
              </Border>

              <!-- Node: solo si la carpeta tiene package.json -->
              <Border Background="{DynamicResource WinBrush}" CornerRadius="8" Padding="12,10" IsVisible="{Binding HasNode}">
                <StackPanel Spacing="8">
                  <DockPanel>
                    <ctl:Chip DockPanel.Dock="Right" Text="{Binding NodeChip}" Tone="{Binding NodeChipTone}" IsVisible="{Binding HasNodeChip}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <ctl:Icon Data="{StaticResource IcNode}" Size="15" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                      <TextBlock Classes="lbl" Text="Node" VerticalAlignment="Center" />
                      <ctl:Chip Text="Vite" Tone="Accent" IsVisible="{Binding NodeUsesVite}" />
                    </StackPanel>
                  </DockPanel>
                  <TextBlock Classes="small" Text="{Binding NodeText}" TextWrapping="Wrap" IsVisible="{Binding NodeReady}" />
                  <TextBlock Classes="faint" Text="{Binding NodeManagerText}" TextWrapping="Wrap" />
                  <ctl:Note Tone="Warn" IsVisible="{Binding HasNodeProblem}">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{Binding NodeProblemText}" TextWrapping="Wrap" />
                      <Button Classes="sm primary" Content="{Binding NodeInstallNodeLabel}" Command="{Binding NodeInstallNodeCommand}" IsVisible="{Binding CanInstallNode}"
                              IsEnabled="{Binding NodeIdle}" HorizontalAlignment="Left" ToolTip.Tip="El zip de nodejs.org, con su SHA-256 comprobado antes de instalar nada" />
                    </StackPanel>
                  </ctl:Note>
                  <ctl:Note Tone="{Binding NodeDev.ResultTone, FallbackValue=Accent}" IsVisible="{Binding HasNodeDev}">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{Binding NodeDev.StatusText, FallbackValue=''}" TextWrapping="Wrap" FontWeight="SemiBold" />
                      <TextBlock Classes="small" Text="{Binding NodeDev.UrlWarning, FallbackValue=''}" TextWrapping="Wrap" Foreground="{DynamicResource WarnBrush}"
                                 IsVisible="{Binding NodeDev.HasUrlWarning, FallbackValue=False}" />
                      <WrapPanel ItemSpacing="6" LineSpacing="6">
                        <Button Classes="sm" Content="Ver salida" Command="{Binding NodeShowDevCommand}" />
                        <Button Classes="sm" Content="Abrir" Command="{Binding NodeOpenDevCommand}" IsVisible="{Binding NodeDev.CanOpen, FallbackValue=False}"
                                ToolTip.Tip="{Binding NodeDev.Url, FallbackValue=''}" />
                        <Button Classes="sm danger" Content="Parar" Command="{Binding NodeStopDevCommand}" IsVisible="{Binding NodeDev.Running, FallbackValue=False}"
                                ToolTip.Tip="Termina el proceso y todo lo que haya lanzado" />
                      </WrapPanel>
                    </StackPanel>
                  </ctl:Note>
                  <StackPanel Spacing="6" IsVisible="{Binding NodeReady}" IsEnabled="{Binding NodeIdle}">
                    <Button Classes="sm" Classes.primary="{Binding NodeNeedsInstall}" Content="{Binding NodeInstallLabel}" Command="{Binding NodeInstallDepsCommand}"
                            IsVisible="{Binding NodeCanInstallDeps}" HorizontalAlignment="Left" ToolTip.Tip="Instala las dependencias del package.json (crea node_modules/)" />
                    <ItemsControl ItemsSource="{Binding NodeScripts}" IsVisible="{Binding HasNodeScripts}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NodeScriptButton">
                          <Button Classes="sm" Content="{Binding Label}" ToolTip.Tip="{Binding Tip}"
                                  Command="{Binding $parent[ItemsControl].((vm:SitesViewModel)DataContext).NodeRunScriptCommand}" CommandParameter="{Binding}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <StackPanel Spacing="6" IsVisible="{Binding NodeUsesVite}">
                    <TextBlock Classes="faint" Text="{Binding NodeViteHint}" TextWrapping="Wrap" />
                    <Button Classes="sm" Content="Copiar server de Vite" Command="{Binding NodeCopyViteCommand}" HorizontalAlignment="Left"
                            ToolTip.Tip="host, https (el certificado y la clave del sitio), hmr y cors, para vite.config.js" />
                  </StackPanel>
                  <TextBlock Classes="faint" TextWrapping="Wrap"
                             Text="npm ejecuta los scripts del package.json y los de instalación de sus dependencias: úsalo con proyectos en los que confíes." />
                </StackPanel>
              </Border>

              <!-- La base de datos del sitio -->
              <Border Background="{DynamicResource WinBrush}" CornerRadius="8" Padding="12,10">
                <StackPanel Spacing="8">
                  <DockPanel>
                    <ctl:Chip DockPanel.Dock="Right" Text="{Binding SiteDbChip}" Tone="{Binding SiteDbTone}" IsVisible="{Binding HasSiteDbChip}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <ctl:Icon Data="{StaticResource IcDatabase}" Size="15" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                      <TextBlock Classes="lbl" Text="Base de datos" VerticalAlignment="Center" />
                    </StackPanel>
                  </DockPanel>
                  <TextBlock TextWrapping="Wrap">
                    <Run Text="{Binding SiteDbName, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" />
                    <Run Text="{Binding SiteDbWhere, Mode=OneWay}" Foreground="{DynamicResource FaintBrush}" FontSize="12" />
                  </TextBlock>
                  <TextBlock Classes="small" Text="{Binding SiteDbHint}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" IsVisible="{Binding HasSiteDbHint}" />
                  <WrapPanel ItemSpacing="6" LineSpacing="6">
                    <Button Classes="sm" Content="{Binding CreateSiteDbLabel}" Command="{Binding CreateSiteDbCommand}" IsVisible="{Binding SiteDbCanCreate}"
                            ToolTip.Tip="CREATE DATABASE (utf8mb4) en la base de datos global" />
                    <Button Classes="sm" Content="Abrir consola" Command="{Binding OpenSiteDbConsoleCommand}" IsVisible="{Binding SiteDbCanOpen}"
                            ToolTip.Tip="La consola SQL, ya dentro de esta base de datos" />
                    <Button Classes="sm" Content="Copiar .env" Command="{Binding CopySiteEnvCommand}" IsVisible="{Binding HasSiteDbEnv}"
                            ToolTip.Tip="DB_CONNECTION, DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME y DB_PASSWORD" />
                    <Button Classes="sm primary" Content="Iniciar todo" Command="{Binding StartForDbCommand}" IsVisible="{Binding SiteDbStopped}" />
                    <Button Classes="sm" Content="Ir a Bases de datos" Command="{Binding GoDatabasesCommand}" IsVisible="{Binding SiteDbMissing}" />
                  </WrapPanel>
                </StackPanel>
              </Border>

              <!-- Pasos y plantillas: los pasos de instalación del proyecto (Laravel, Symfony, WordPress o Composer) -->
              <Border Background="{DynamicResource WinBrush}" CornerRadius="8" Padding="12,10" IsVisible="{Binding HasDeploySteps}">
                <StackPanel Spacing="8">
                  <DockPanel>
                    <ctl:Chip DockPanel.Dock="Right" Text="{Binding DeployProjectText}" Tone="Accent" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <ctl:Icon Data="{StaticResource IcCheck}" Size="15" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                      <TextBlock Classes="lbl" Text="Pasos de instalación" VerticalAlignment="Center" />
                    </StackPanel>
                  </DockPanel>
                  <TextBlock Classes="faint" Text="{Binding DeployStepsText}" TextWrapping="Wrap" />
                  <Button Classes="sm" Content="Pasos de instalación…" Command="{Binding DeployStepsCommand}" IsEnabled="{Binding DeployIdle}" HorizontalAlignment="Left"
                          ToolTip.Tip="Lo que hace falta para que funcione: Roost propone los pasos y tú eliges cuáles" />
                </StackPanel>
              </Border>

              <!-- Compartir (oleada 6): por internet con un túnel rápido de Cloudflare, o en la red local -->
              <Border Background="{DynamicResource WinBrush}" CornerRadius="8" Padding="12,10">
                <StackPanel Spacing="8">
                  <DockPanel>
                    <ctl:Chip DockPanel.Dock="Right" Text="{Binding ShareChip}" Tone="{Binding ShareChipTone}" ShowDot="True" IsVisible="{Binding IsSharing}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <ctl:Icon Data="{StaticResource IcShare}" Size="15" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                      <TextBlock Classes="lbl" Text="Compartir" VerticalAlignment="Center" />
                    </StackPanel>
                  </DockPanel>
                  <TextBlock Classes="faint" TextWrapping="Wrap" IsVisible="{Binding ShareIntroVisible}"
                             Text="Enséñalo fuera de tu equipo mientras lo necesites: por internet con un enlace temporal de Cloudflare, o en tu red local (un móvil en la misma wifi). Nada se comparte solo." />
                  <ctl:Note Tone="Bad" IsVisible="{Binding HasSiteTunnel}">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{Binding TunnelHeadline}" TextWrapping="Wrap" FontWeight="SemiBold" />
                      <SelectableTextBlock Classes="mono" Text="{Binding SiteTunnel.Url, FallbackValue=''}" TextWrapping="Wrap" />
                      <TextBlock Classes="small" TextWrapping="Wrap" IsVisible="{Binding TunnelConnecting}"
                                 Text="Cloudflare aún está preparando la conexión: si da error, prueba en unos segundos." />
                      <WrapPanel ItemSpacing="6" LineSpacing="6">
                        <Button Classes="sm" Content="Copiar" Command="{Binding CopyTunnelUrlCommand}" ToolTip.Tip="Copiar el enlace para mandarlo" />
                        <Button Classes="sm" Content="Abrir" Command="{Binding OpenTunnelUrlCommand}" ToolTip.Tip="Abrir el enlace en el navegador" />
                        <Button Classes="sm danger" Content="Dejar de compartir" Command="{Binding StopTunnelCommand}" IsEnabled="{Binding ShareIdle}"
                                ToolTip.Tip="Cierra el túnel: el enlace deja de funcionar" />
                      </WrapPanel>
                    </StackPanel>
                  </ctl:Note>
                  <ctl:Note Tone="Warn" IsVisible="{Binding HasSiteLan}">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{Binding LanHeadline}" TextWrapping="Wrap" FontWeight="SemiBold" />
                      <SelectableTextBlock Classes="mono" Text="{Binding SiteLan.Url, FallbackValue=''}" TextWrapping="Wrap" />
                      <TextBlock Classes="small" Text="{Binding LanCertHint}" TextWrapping="Wrap" />
                      <WrapPanel ItemSpacing="6" LineSpacing="6">
                        <Button Classes="sm" Content="Copiar" Command="{Binding CopyLanUrlCommand}" ToolTip.Tip="Copiar la dirección para abrirla en el móvil" />
                        <Button Classes="sm" Content="Abrir" Command="{Binding OpenLanUrlCommand}" ToolTip.Tip="Abrir la dirección en el navegador" />
                        <Button Classes="sm danger" Content="Dejar de compartir" Command="{Binding StopLanCommand}" IsEnabled="{Binding ShareIdle}"
                                ToolTip.Tip="Deja de escuchar en la red local y quita la regla del cortafuegos (Windows pide permiso)" />
                      </WrapPanel>
                    </StackPanel>
                  </ctl:Note>
                  <ctl:Note Tone="Bad" IsVisible="{Binding ShowShareDebug}">
                    <TextBlock Text="{Binding ShareDebugText}" TextWrapping="Wrap" />
                  </ctl:Note>
                  <TextBlock Classes="small" Text="{Binding ShareUrlsHint}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" IsVisible="{Binding IsSharing}" />
                  <TextBlock Classes="small" Text="{Binding ShareBusyText}" TextWrapping="Wrap" IsVisible="{Binding ShareBusy}" />
                  <StackPanel Spacing="6" IsVisible="{Binding ShareStackStopped}">
                    <TextBlock Classes="small" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Text="Para compartirlo, el stack tiene que estar en marcha." />
                    <Button Classes="sm primary" Content="Iniciar todo" Command="{Binding ShareStartStackCommand}" HorizontalAlignment="Left" />
                  </StackPanel>
                  <WrapPanel ItemSpacing="6" LineSpacing="6" IsEnabled="{Binding ShareIdle}" IsVisible="{Binding !ShareStackStopped}">
                    <Button Classes="sm" Content="Compartir por internet…" Command="{Binding ShareTunnelCommand}" IsVisible="{Binding !HasSiteTunnel}"
                            ToolTip.Tip="Un enlace https://….trycloudflare.com que lleva a este sitio, sin cuenta. Antes de nada te dice lo que implica." />
                    <Button Classes="sm" Content="En la red local…" Command="{Binding ShareLanCommand}" IsVisible="{Binding !HasSiteLan}"
                            ToolTip.Tip="Para el móvil u otro equipo de tu wifi: HTTPS en la IP de este equipo, con una regla del cortafuegos solo para tu red privada" />
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="8">
                <TextBlock Classes="muted" Text="Certificado" />
                <StackPanel Grid.Column="1" Spacing="4">
                  <ctl:Chip Text="{Binding Selected.Cert, FallbackValue=''}" Tone="{Binding Selected.CertTone, FallbackValue=Neutral}" />
                  <TextBlock Classes="faint" Text="{Binding CertDetail}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Row="1" Classes="muted" Text="vhost" />
                <TextBlock Grid.Row="1" Grid.Column="1" Classes="mono" Text="{Binding ConfPath}" TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding ConfPath}" />
              </Grid>
              <WrapPanel ItemSpacing="8" LineSpacing="8">
                <Button Classes="sm" Content="Carpeta" Command="{Binding OpenFolderCommand}" />
                <Button Classes="sm" Content="Abrir en el editor" Command="{Binding OpenInEditorCommand}" ToolTip.Tip="El editor se elige en Ajustes › Programas" />
                <Button Classes="sm" Content="Terminal aquí" Command="{Binding OpenTerminalCommand}" />
                <Button Classes="sm" Content="Editar vhost" Command="{Binding EditConfCommand}" />
                <!-- Sitios avanzados (C5): sus registros de accesos y errores -->
                <Button Classes="sm" Content="Registros" Command="{Binding ViewLogsCommand}" ToolTip.Tip="Los accesos y los errores de este sitio, en Registros" />
                <Button Classes="sm" Content="Renovar certificado" Command="{Binding RenewCertCommand}" />
              </WrapPanel>
              <ctl:Note Tone="Accent">
                <TextBlock TextWrapping="Wrap">
                  <Run Text="En el vhost puedes editar todo lo que esté fuera de las marcas " />
                  <Run Text="roost:begin" FontFamily="{StaticResource MonoFont}" />
                  <Run Text=" / " />
                  <Run Text="roost:end" FontFamily="{StaticResource MonoFont}" />
                  <Run Text="." />
                </TextBlock>
              </ctl:Note>
              <Border BorderBrush="{DynamicResource Line2Brush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Classes="sm danger" Content="Quitar sitio" Command="{Binding RemoveCommand}" />
                  <TextBlock Classes="faint" Text="La carpeta del proyecto no se toca." VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
