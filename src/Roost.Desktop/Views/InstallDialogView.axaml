<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Roost.Desktop.ViewModels"
             xmlns:ctl="using:Roost.Desktop.Controls"
             x:Class="Roost.Desktop.Views.InstallDialogView"
             x:DataType="vm:InstallDialogViewModel">
  <Border Classes="modal" Width="560">
    <DockPanel>
      <Border DockPanel.Dock="Bottom" Classes="modal-f">
        <DockPanel>
          <Button DockPanel.Dock="Left" Content="Seguir en segundo plano" Command="{Binding BackgroundCommand}" IsVisible="{Binding Running}" />
          <Button HorizontalAlignment="Right" Content="Cancelar" Command="{Binding CancelCommand}" IsVisible="{Binding Running}" />
          <Button HorizontalAlignment="Right" Classes="primary" Content="Cerrar" Command="{Binding CancelCommand}" IsVisible="{Binding Done}" />
        </DockPanel>
      </Border>
      <StackPanel Spacing="14" Margin="20,18,20,18">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Border Classes="badge-ic" Classes.bad="{Binding Failed}">
            <ctl:Icon Data="{StaticResource IcDownload}" Size="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Classes="h3" Text="{Binding Title}" />
            <TextBlock Classes="faint" Text="{Binding Subtitle}" />
          </StackPanel>
        </Grid>

        <StackPanel Spacing="6">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Classes="mono" Text="{Binding BytesText}" />
            <TextBlock Classes="small strong" Text="{Binding Phase}" />
          </DockPanel>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" IsIndeterminate="{Binding Indeterminate}"
                       AutomationProperties.Name="Progreso de la instalación" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Steps}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:InstallStep">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Border Width="22" Height="22" CornerRadius="11"
                        Classes="step" Classes.done="{Binding IsDone}" Classes.active="{Binding IsActive}"
                        Classes.failed="{Binding Tone, Converter={x:Static ctl:ToneConverters.IsBad}}">
                  <Panel>
                    <ctl:Icon Data="{StaticResource IcCheck}" Size="13" StrokeThickness="2.4" IsVisible="{Binding IsDone}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <ctl:Icon Data="{StaticResource IcDot}" Size="12" Filled="True" IsVisible="{Binding !IsDone}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Panel>
                </Border>
                <TextBlock Grid.Column="1" Classes="small" VerticalAlignment="Center" TextWrapping="Wrap">
                  <Run Text="{Binding Label, Mode=OneWay}" FontWeight="{Binding IsActive, Converter={x:Static ctl:ToneConverters.Bold}}" />
                  <Run Text="{Binding Hint, Mode=OneWay}" Foreground="{DynamicResource FaintBrush}" />
                </TextBlock>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <CheckBox Classes="small" IsVisible="{Binding HasOption}" IsChecked="{Binding OptionChecked}" IsEnabled="{Binding Running}">
          <TextBlock Text="{Binding OptionText}" TextWrapping="Wrap" FontSize="12" />
        </CheckBox>
        <ctl:Note Tone="Bad" IsVisible="{Binding Failed}" Content="{Binding Error}" />
        <ctl:Note Tone="Accent" IsVisible="{Binding !Failed}"
                  Content="Si algo falla, no queda nada a medias: ni una carpeta rota ni el zip sin verificar." />
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
