<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Roost.Desktop.ViewModels"
             xmlns:ctl="using:Roost.Desktop.Controls"
             x:Class="Roost.Desktop.Views.LogsView"
             x:DataType="vm:LogsViewModel">
  <Grid RowDefinitions="Auto,*">
    <Grid ColumnDefinitions="*,Auto" Margin="24,18,24,14">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Classes="h1" Text="Registros" />
        <TextBlock Classes="sub" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <Button Grid.Column="1" Content="Abrir carpeta" Command="{Binding OpenFolderCommand}" />
    </Grid>

    <Grid Grid.Row="1" Margin="24,0,24,24" ColumnDefinitions="250,*" ColumnSpacing="16">
      <!-- Ficheros -->
      <Border Classes="card">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="card-h"><TextBlock Classes="h2" Text="Ficheros" /></Border>
          <!-- Sitios avanzados (C5): los registros de un solo sitio -->
          <ComboBox DockPanel.Dock="Top" Margin="12,10,12,4" HorizontalAlignment="Stretch" ItemsSource="{Binding SiteFilters}" SelectedItem="{Binding SiteFilter}"
                    AutomationProperties.Name="Registros de un sitio" ToolTip.Tip="Solo los registros (accesos y errores) de un sitio" />
          <ScrollViewer>
            <StackPanel>
              <TextBlock Classes="muted" Margin="16,12" TextWrapping="Wrap" Text="{Binding Empty}" IsVisible="{Binding HasEmpty}" />
              <ItemsControl ItemsSource="{Binding Files}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LogFile">
                    <Button Classes="row" Classes.sel="{Binding IsSelected}"
                            Command="{Binding $parent[ItemsControl].((vm:LogsViewModel)DataContext).ChooseCommand}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Title}">
                      <Border Classes="tr" Padding="16,8" MinHeight="0">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <StackPanel>
                            <TextBlock Classes="strong small" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="faint mono" FontSize="11" Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <ctl:Chip Grid.Column="1" Text="{Binding Badge}" Tone="{Binding BadgeTone}" IsVisible="{Binding HasBadge}" />
                        </Grid>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Visor -->
      <Border Grid.Column="1" Classes="card">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="card-h">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="lbl" Text="Filtrar" VerticalAlignment="Center" />
                <TextBox Width="160" MinHeight="30" Height="30" PlaceholderText="texto" Text="{Binding Filter}" AutomationProperties.Name="Filtrar" />
                <CheckBox Content="Seguir" IsChecked="{Binding Follow}" FontSize="12" />
                <Button Classes="sm icon" Command="{Binding CopyCommand}" ToolTip.Tip="Copiar" AutomationProperties.Name="Copiar">
                  <ctl:Icon Data="{StaticResource IcCopy}" Size="15" />
                </Button>
                <Button Classes="sm icon" Command="{Binding OpenFileCommand}" ToolTip.Tip="Abrir con el editor" AutomationProperties.Name="Abrir con el editor">
                  <ctl:Icon Data="{StaticResource IcExternal}" Size="15" />
                </Button>
              </StackPanel>
              <TextBlock Classes="h2 mono" Text="{Binding Selected.Display, FallbackValue=''}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
          </Border>
          <Border Classes="log" Margin="16,14">
            <ScrollViewer Name="LogScroll" HorizontalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Lines}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LogLine">
                    <TextBlock Classes="logline" Classes.e="{Binding IsError}" Classes.w="{Binding IsWarn}" Classes.m="{Binding IsMuted}"
                               Text="{Binding Text}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
