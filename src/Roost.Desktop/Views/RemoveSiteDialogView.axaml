<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Roost.Desktop.ViewModels"
             xmlns:ctl="using:Roost.Desktop.Controls"
             xmlns:sys="using:System"
             x:Class="Roost.Desktop.Views.RemoveSiteDialogView"
             x:DataType="vm:RemoveSiteDialogViewModel">
  <!-- Git-app: Quitar un sitio, con la casilla de la clave y el token (texto 15 del diseño de git) -->
  <Border Classes="modal" Width="560">
    <DockPanel>
      <Border DockPanel.Dock="Bottom" Classes="modal-f">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Cancelar" Command="{Binding CancelCommand}" />
          <Button Classes="danger-fill" Content="Quitar sitio" Command="{Binding ConfirmCommand}" />
        </StackPanel>
      </Border>
      <StackPanel Spacing="14" Margin="20,18,20,18">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Border Classes="badge-ic warn">
            <ctl:Icon Data="{StaticResource IcTrash}" Size="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Grid.Column="1" Classes="h3" Text="{Binding Title}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </Grid>
        <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
        <Border Background="{DynamicResource WinBrush}" CornerRadius="8" Padding="12,10" IsVisible="{Binding HasAccess}">
          <StackPanel Spacing="8">
            <CheckBox IsChecked="{Binding RemoveAccess}" Content="Quitar también la clave SSH y el token de este sitio" />
            <ItemsControl ItemsSource="{Binding Removing}" Margin="28,0,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sys:String">
                  <TextBlock Classes="faint" Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <ItemsControl ItemsSource="{Binding Kept}" IsVisible="{Binding HasKept}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="sys:String">
              <TextBlock Classes="faint" Text="{Binding}" TextWrapping="Wrap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
