<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Roost.Desktop.ViewModels"
             xmlns:ctl="using:Roost.Desktop.Controls"
             x:Class="Roost.Desktop.Views.WebServerView"
             x:DataType="vm:WebServerViewModel">
  <ScrollViewer>
    <StackPanel>
      <StackPanel Margin="24,18,24,14">
        <TextBlock Classes="h1" Text="Servidor web" />
        <TextBlock Classes="sub" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <StackPanel Margin="24,0,24,24" Spacing="16">
        <!-- Servidor activo y puertos -->
        <Border Classes="card">
          <StackPanel>
            <Border Classes="card-h">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="h2" Text="Servidor activo" />
                <TextBlock Classes="hint" Text="Cambiarlo rearranca el stack" />
              </StackPanel>
            </Border>
            <Grid Margin="16,14" ColumnDefinitions="*,Auto" ColumnSpacing="24">
              <StackPanel Spacing="10">
                <TextBlock Classes="lbl" Text="Arranca con Iniciar todo" />
                <RadioButton GroupName="servidor" IsChecked="{Binding UseNginx}">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="strong" Text="{Binding NginxVersion, StringFormat='nginx {0}'}" />
                      <ctl:Chip Text="{Binding NginxState}" Tone="{Binding NginxStateTone}" />
                    </StackPanel>
                    <TextBlock Classes="faint" Text="Rápido y ligero. PHP NTS a través de los pools de php-cgi" />
                  </StackPanel>
                </RadioButton>
                <RadioButton GroupName="servidor" IsChecked="{Binding UseApache}">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="strong" Text="{Binding ApacheVersion, StringFormat='Apache {0}'}" />
                      <ctl:Chip Text="{Binding ApacheState}" Tone="{Binding ApacheStateTone}" />
                    </StackPanel>
                    <TextBlock Classes="faint" Text="Lee los .htaccess (WordPress, Laravel...). Los mismos PHP, y cada sitio con el suyo" />
                  </StackPanel>
                </RadioButton>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
                <StackPanel Spacing="6">
                  <TextBlock Classes="lbl" Text="Puerto HTTP" />
                  <TextBox Classes="mono" Width="96" Text="{Binding HttpText}" AutomationProperties.Name="Puerto HTTP" />
                  <ctl:Chip Text="{Binding HttpChip}" Tone="{Binding HttpTone}" />
                </StackPanel>
                <StackPanel Spacing="6">
                  <TextBlock Classes="lbl" Text="Puerto HTTPS" />
                  <TextBox Classes="mono" Width="96" Text="{Binding HttpsText}" AutomationProperties.Name="Puerto HTTPS" />
                  <ctl:Chip Text="{Binding HttpsChip}" Tone="{Binding HttpsTone}" />
                </StackPanel>
                <Button Classes="primary" Content="Aplicar" Command="{Binding ApplyPortsCommand}" IsEnabled="{Binding CanApplyPorts}" Margin="0,0,0,28" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="seg">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <RadioButton Theme="{StaticResource SegButton}" GroupName="web-tab" Content="nginx" IsChecked="{Binding ShowNginx}" />
            <RadioButton Theme="{StaticResource SegButton}" GroupName="web-tab" Content="Apache 2" IsChecked="{Binding ShowApache}" />
          </StackPanel>
        </Border>

        <!-- nginx -->
        <Grid ColumnDefinitions="*,340" ColumnSpacing="16" IsVisible="{Binding ShowNginx}">
          <Border Classes="card" VerticalAlignment="Top">
            <StackPanel>
              <Border Classes="card-h"><TextBlock Classes="h2" Text="Instalado" /></Border>
              <StackPanel Margin="16,14" Spacing="14">
                <ctl:Note Tone="Accent" IsVisible="{Binding !NginxInstalled}"
                          Content="nginx aún no está instalado: se instala solo la primera vez que pulsas Iniciar todo, o desde Disponibles." />
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="Medium" Text="{Binding NginxVersion}" VerticalAlignment="Center" />
                  <ctl:Chip Text="rama estable" Tone="Ok" />
                  <ctl:Chip Text="SHA-256 y firma PGP verificados" />
                </StackPanel>
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="8">
                  <TextBlock Classes="muted" Text="Carpeta" VerticalAlignment="Center" />
                  <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,-6">
                    <TextBlock Classes="mono" Text="{Binding NginxFolder}" TextTrimming="LeadingCharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding NginxFolder}" />
                    <Button Grid.Column="1" Classes="sm ghost icon" Margin="4,0,0,0" Command="{Binding OpenFolderCommand}" ToolTip.Tip="Abrir la carpeta"
                            AutomationProperties.Name="Abrir la carpeta de nginx" IsEnabled="{Binding NginxInstalled}">
                      <ctl:Icon Data="{StaticResource IcFolder}" Size="14" />
                    </Button>
                  </Grid>
                  <TextBlock Grid.Row="1" Classes="muted" Text="Escucha en" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Classes="mono" Text="{Binding Listen}" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="2" Classes="muted" Text="Módulos" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Classes="small" Text="{Binding Modules}" />
                </Grid>
                <StackPanel Spacing="6">
                  <TextBlock Classes="lbl" Text="Configuración" />
                  <Border BorderBrush="{DynamicResource Line2Brush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                      <Border Classes="tr" MinHeight="42" Padding="14,6">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                          <TextBlock Classes="mono" Text="etc\nginx\nginx.conf" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Classes="faint" Text="generado: no se edita" VerticalAlignment="Center" />
                          <Button Grid.Column="2" Classes="sm ghost" Content="Ver" Command="{Binding OpenConfCommand}" AutomationProperties.Name="Ver nginx.conf" />
                        </Grid>
                      </Border>
                      <Border Classes="tr" MinHeight="42" Padding="14,6">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                          <TextBlock Classes="mono" Text="etc\nginx\sites\*.conf" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Classes="faint" Text="uno por sitio: editable fuera de las marcas" VerticalAlignment="Center" />
                          <Button Grid.Column="2" Classes="sm ghost" Content="Sitios" Command="{Binding GoSitesCommand}" />
                        </Grid>
                      </Border>
                      <Border Classes="tr" MinHeight="42" Padding="14,6" BorderThickness="0">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                          <TextBlock Classes="mono" Text="logs\nginx-error.log" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Classes="faint" Text="errores y avisos" VerticalAlignment="Center" />
                          <Button Grid.Column="2" Classes="sm ghost" Content="Abrir" Command="{Binding GoErrorLogCommand}" AutomationProperties.Name="Abrir el log de errores de nginx" />
                        </Grid>
                      </Border>
                    </StackPanel>
                  </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="sm" Content="Validar configuración (nginx -t)" Command="{Binding TestConfigCommand}" IsEnabled="{Binding NginxInstalled}" />
                  <Button Classes="sm" Content="Recargar" Command="{Binding ReloadCommand}" IsEnabled="{Binding NginxRunning}"
                          ToolTip.Tip="Valida la configuración y nginx la lee otra vez sin cortar las conexiones" />
                </StackPanel>
                <ctl:Note Tone="{Binding TestTone}" IsVisible="{Binding HasTestOutput}">
                  <SelectableTextBlock Classes="mono" Text="{Binding TestOutput}" TextWrapping="Wrap" FontSize="11.5" />
                </ctl:Note>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Classes="card" VerticalAlignment="Top">
            <StackPanel>
              <Border Classes="card-h">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Classes="h2" Text="Disponibles" />
                  <TextBlock Classes="hint" Text="nginx.org" />
                </StackPanel>
              </Border>
              <Border Classes="tr" MinHeight="50" Padding="16,8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <ctl:Dot Tone="Ok" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Classes="mono strong" Text="{Binding CatalogVersion}" />
                    <TextBlock Classes="faint" Text="estable: la recomendada" />
                  </StackPanel>
                  <ctl:Chip Grid.Column="2" Text="instalada" IsVisible="{Binding NginxInstalled}" />
                  <Button Grid.Column="2" Classes="sm" Content="Instalar" Command="{Binding InstallNginxCommand}" IsVisible="{Binding !NginxInstalled}"
                          AutomationProperties.Name="Instalar nginx" />
                </Grid>
              </Border>
              <ctl:Note Tone="Accent" Margin="16,12"
                        Content="nginx.org no publica checksums: Roost solo instala versiones cuya firma PGP se ha verificado, y cada versión nueva llega con una actualización de Roost." />
            </StackPanel>
          </Border>
        </Grid>

        <!-- Apache -->
        <Grid ColumnDefinitions="*,340" ColumnSpacing="16" IsVisible="{Binding ShowApache}">
          <Border Classes="card" VerticalAlignment="Top">
            <StackPanel>
              <Border Classes="card-h"><TextBlock Classes="h2" Text="Instalado" /></Border>
              <StackPanel Margin="16,14" Spacing="14">
                <ctl:Note Tone="Accent" IsVisible="{Binding !ApacheInstalled}"
                          Content="Apache aún no está instalado: se instala al elegirlo arriba como servidor activo, o desde Disponibles." />
                <!-- El detalle, solo con Apache instalado: antes no hay carpeta, ni config, ni nada que validar. -->
                <StackPanel Spacing="14" IsVisible="{Binding ApacheInstalled}">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="Medium" Text="{Binding ApacheVersion}" VerticalAlignment="Center" />
                    <ctl:Chip Text="Apache Lounge · Win64" Tone="Ok" />
                    <ctl:Chip Text="SHA-256 y firma PGP verificados" />
                  </StackPanel>
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="8">
                    <TextBlock Classes="muted" Text="Carpeta" VerticalAlignment="Center" />
                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,-6">
                      <TextBlock Classes="mono" Text="{Binding ApacheFolder}" TextTrimming="LeadingCharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding ApacheFolder}" />
                      <Button Grid.Column="1" Classes="sm ghost icon" Margin="4,0,0,0" Command="{Binding OpenApacheFolderCommand}" ToolTip.Tip="Abrir la carpeta"
                              AutomationProperties.Name="Abrir la carpeta de Apache" IsEnabled="{Binding ApacheInstalled}">
                        <ctl:Icon Data="{StaticResource IcFolder}" Size="14" />
                      </Button>
                    </Grid>
                    <TextBlock Grid.Row="1" Classes="muted" Text="Escucha en" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="mono" Text="{Binding Listen}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" Classes="muted" Text="PHP" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="small" TextWrapping="Wrap"
                               Text="Por mod_proxy_fcgi a los mismos pools de php-cgi que nginx: el PHP NTS de siempre, y cada sitio con su versión (sin mod_php ni builds TS)." />
                    <TextBlock Grid.Row="3" Classes="muted" Text="Módulos" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Classes="small" Text="{Binding ApacheModules}" TextWrapping="Wrap" />
                  </Grid>
                  <StackPanel Spacing="6">
                    <TextBlock Classes="lbl" Text="Configuración" />
                    <Border BorderBrush="{DynamicResource Line2Brush}" BorderThickness="1" CornerRadius="8">
                      <StackPanel>
                        <Border Classes="tr" MinHeight="42" Padding="14,6">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <TextBlock Classes="mono" Text="etc\apache\httpd.conf" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Classes="faint" Text="generado: no se edita" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Classes="sm ghost" Content="Ver" Command="{Binding OpenApacheConfCommand}" AutomationProperties.Name="Ver httpd.conf" />
                          </Grid>
                        </Border>
                        <Border Classes="tr" MinHeight="42" Padding="14,6">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <TextBlock Classes="mono" Text="etc\apache\sites\*.conf" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Classes="faint" Text="uno por sitio; lo del proyecto, mejor en su .htaccess" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Classes="sm ghost" Content="Sitios" Command="{Binding GoSitesCommand}" />
                          </Grid>
                        </Border>
                        <Border Classes="tr" MinHeight="42" Padding="14,6" BorderThickness="0">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <TextBlock Classes="mono" Text="logs\apache-error.log" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Classes="faint" Text="errores y avisos" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Classes="sm ghost" Content="Abrir" Command="{Binding GoApacheErrorLogCommand}" AutomationProperties.Name="Abrir el log de errores de Apache" />
                          </Grid>
                        </Border>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="sm" Content="Validar configuración (httpd -t)" Command="{Binding TestApacheConfigCommand}" IsEnabled="{Binding ApacheInstalled}" />
                    <Button Classes="sm" Content="Recargar" Command="{Binding ReloadApacheCommand}" IsEnabled="{Binding ApacheRunning}"
                            ToolTip.Tip="Valida la configuración y Apache la lee otra vez sin cortar las conexiones" />
                  </StackPanel>
                  <ctl:Note Tone="{Binding ApacheTestTone}" IsVisible="{Binding HasApacheTestOutput}">
                    <SelectableTextBlock Classes="mono" Text="{Binding ApacheTestOutput}" TextWrapping="Wrap" FontSize="11.5" />
                  </ctl:Note>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="card" VerticalAlignment="Top">
            <StackPanel>
              <Border Classes="card-h">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Classes="h2" Text="Disponibles" />
                  <TextBlock Classes="hint" Text="Apache Lounge" />
                </StackPanel>
              </Border>
              <Border Classes="tr" MinHeight="50" Padding="16,8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <ctl:Dot Tone="Ok" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Classes="mono strong" Text="{Binding ApacheVersion}" />
                    <TextBlock Classes="faint" Text="Win64 · la recomendada" />
                  </StackPanel>
                  <ctl:Chip Grid.Column="2" Text="instalada" IsVisible="{Binding ApacheInstalled}" />
                  <Button Grid.Column="2" Classes="sm" Content="Instalar" Command="{Binding InstallApacheCommand}" IsVisible="{Binding !ApacheInstalled}"
                          AutomationProperties.Name="Instalar Apache" />
                </Grid>
              </Border>
              <ctl:Note Tone="Accent" Margin="16,12">
                <TextBlock TextWrapping="Wrap"
                           Text="{Binding ApacheRedistributable, StringFormat='Apache no publica binarios para Windows; los de Apache Lounge son el estándar de hecho. Roost solo instala versiones cuya firma PGP se ha verificado. Necesitan el {0}.'}" />
              </ctl:Note>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
