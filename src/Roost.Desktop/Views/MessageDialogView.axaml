<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Roost.Desktop.ViewModels"
             xmlns:ctl="using:Roost.Desktop.Controls"
             x:Class="Roost.Desktop.Views.MessageDialogView"
             x:DataType="vm:MessageDialogViewModel">
  <Border Classes="modal" Width="560">
    <DockPanel>
      <Border DockPanel.Dock="Bottom" Classes="modal-f">
        <DockPanel>
          <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding LeftButtons}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DialogButton">
                <Button Content="{Binding Label}" Classes.primary="{Binding IsPrimary}" Classes.danger-fill="{Binding IsDangerFill}"
                        Command="{Binding $parent[UserControl].((vm:MessageDialogViewModel)DataContext).ChooseCommand}" CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding RightButtons}" HorizontalAlignment="Right">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DialogButton">
                <Button Content="{Binding Label}" Classes.primary="{Binding IsPrimary}" Classes.danger-fill="{Binding IsDangerFill}"
                        Command="{Binding $parent[UserControl].((vm:MessageDialogViewModel)DataContext).ChooseCommand}" CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>
      <StackPanel Spacing="14" Margin="20,18,20,18">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Border Classes="badge-ic"
                  Classes.warn="{Binding Tone, Converter={x:Static ctl:ToneConverters.IsWarn}}"
                  Classes.bad="{Binding Tone, Converter={x:Static ctl:ToneConverters.IsBad}}">
            <ctl:Icon Data="{StaticResource IcInfo}" Size="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Classes="h3" Text="{Binding Title}" TextWrapping="Wrap" />
            <TextBlock Classes="faint" Text="{Binding Subtitle}" TextWrapping="Wrap" IsVisible="{Binding Subtitle, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Grid>
        <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" IsVisible="{Binding Text, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Border Classes="log" IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}" MaxHeight="160">
          <ScrollViewer>
            <SelectableTextBlock Classes="mono" Text="{Binding Detail}" Foreground="{DynamicResource LogTextBrush}" TextWrapping="Wrap" />
          </ScrollViewer>
        </Border>
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
