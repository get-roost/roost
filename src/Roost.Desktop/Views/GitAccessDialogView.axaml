<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Roost.Desktop.ViewModels"
             xmlns:ctl="using:Roost.Desktop.Controls"
             x:Class="Roost.Desktop.Views.GitAccessDialogView"
             x:DataType="vm:GitAccessDialogViewModel">
  <!-- Git-app: Acceso… de un sitio (maqueta I del diseño de git) -->
  <Border Classes="modal" Width="560">
    <DockPanel>
      <Border DockPanel.Dock="Bottom" Classes="modal-f">
        <Button HorizontalAlignment="Right" Classes="primary" Content="Cerrar" Command="{Binding FinishCommand}" IsEnabled="{Binding Idle}" />
      </Border>
      <StackPanel Spacing="14" Margin="20,18,20,18">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <Border Classes="badge-ic">
            <ctl:Icon Data="{StaticResource IcKey}" Size="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Classes="h3" Text="{Binding Title}" />
            <TextBlock Classes="faint mono" FontSize="11.5" Text="{Binding Subtitle}" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="2" Classes="icon ghost" VerticalAlignment="Top" Command="{Binding DismissCommand}" AutomationProperties.Name="Cerrar">
            <ctl:Icon Data="{StaticResource IcClose}" Size="15" />
          </Button>
        </Grid>

        <Grid ColumnDefinitions="104,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="12">
          <!-- Cómo entra -->
          <TextBlock Classes="muted" Text="Clave pública" IsVisible="{Binding IsKey}" Margin="0,2,0,0" />
          <StackPanel Grid.Column="1" Spacing="6" IsVisible="{Binding IsKey}">
            <Border Classes="log" Padding="10,8" IsVisible="{Binding HasPublicKey}">
              <SelectableTextBlock Classes="mono" FontSize="11.5" Text="{Binding PublicKey}" TextWrapping="Wrap" Foreground="{DynamicResource LogTextBrush}" />
            </Border>
            <TextBlock Classes="faint" Text="{Binding KeyText}" TextWrapping="Wrap" />
            <WrapPanel ItemSpacing="6" LineSpacing="6">
              <Button Classes="sm" Content="Copiar" Command="{Binding CopyKeyCommand}" IsVisible="{Binding HasPublicKey}" />
              <Button Classes="sm" Command="{Binding OpenDeployKeysCommand}" IsVisible="{Binding HasDeployKeysUrl}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding DeployKeysText}" VerticalAlignment="Center" />
                  <ctl:Icon Data="{StaticResource IcExternal}" Size="13" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="sm primary" Content="Crear otra clave" Command="{Binding GenerateKeyCommand}" IsVisible="{Binding KeyMissing}" IsEnabled="{Binding Idle}" />
            </WrapPanel>
          </StackPanel>

          <TextBlock Classes="muted" Text="Token" IsVisible="{Binding IsHttps}" Margin="0,2,0,0" />
          <StackPanel Grid.Column="1" Spacing="6" IsVisible="{Binding IsHttps}">
            <TextBlock Classes="small" Text="{Binding TokenText}" TextWrapping="Wrap" />
            <WrapPanel ItemSpacing="6" LineSpacing="6">
              <Button Classes="sm" Content="{Binding TokenLabel}" Command="{Binding ReplaceTokenCommand}" IsEnabled="{Binding Idle}" />
              <Button Classes="sm danger" Content="Quitar token" Command="{Binding RemoveTokenCommand}" IsVisible="{Binding HasToken}" IsEnabled="{Binding Idle}" />
            </WrapPanel>
          </StackPanel>

          <TextBlock Classes="muted" Text="Acceso" IsVisible="{Binding IsOwn}" Margin="0,2,0,0" />
          <TextBlock Grid.Column="1" Classes="small" IsVisible="{Binding IsOwn}" TextWrapping="Wrap"
                     Text="Tus claves SSH (las de ~/.ssh y el ssh-agent de Windows), como en tu terminal. Roost no guarda nada." />

          <TextBlock Grid.Row="1" Classes="muted" Text="Servidor" Margin="0,2,0,0" />
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <ctl:Dot Tone="{Binding ServerTone}" VerticalAlignment="Top" Margin="0,5,0,0" />
            <TextBlock Classes="small" Text="{Binding ServerText}" TextWrapping="Wrap" MaxWidth="390" />
          </StackPanel>

          <TextBlock Grid.Row="2" Classes="muted" Text="Último acceso" Margin="0,2,0,0" />
          <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <ctl:Dot Tone="{Binding LastTone}" VerticalAlignment="Top" Margin="0,5,0,0" />
            <TextBlock Classes="small" Text="{Binding LastText}" TextWrapping="Wrap" MaxWidth="390" />
          </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="sm primary" Content="Probar acceso" Command="{Binding TestCommand}" IsEnabled="{Binding Idle}"
                  ToolTip.Tip="Pregunta al remoto (ls-remote) con el acceso del sitio; no descarga nada" />
        </StackPanel>

        <Border BorderBrush="{DynamicResource Line2Brush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" IsVisible="{Binding HasPublicKey}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="sm danger" Content="Quitar la clave" Command="{Binding RemoveKeyCommand}" IsEnabled="{Binding Idle}" />
            <TextBlock Classes="faint" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="380"
                       Text="Borra la clave privada de este equipo. Quita también la pública en el proveedor." />
          </StackPanel>
        </Border>
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
