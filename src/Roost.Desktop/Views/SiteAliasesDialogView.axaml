<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Roost.Desktop.ViewModels"
             xmlns:ctl="using:Roost.Desktop.Controls"
             x:Class="Roost.Desktop.Views.SiteAliasesDialogView"
             x:DataType="vm:SiteAliasesDialogViewModel">
  <!-- Sitios avanzados (C7): los alias y los subdominios de un sitio -->
  <Border Classes="modal" Width="580">
    <DockPanel>
      <Border DockPanel.Dock="Bottom" Classes="modal-f">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Cancelar" Command="{Binding DismissCommand}" />
          <Button Classes="primary" Content="Guardar" Command="{Binding ConfirmCommand}" IsEnabled="{Binding Changed}" />
        </StackPanel>
      </Border>
      <StackPanel Spacing="14" Margin="20,18,20,18">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <Border Classes="badge-ic">
            <ctl:Icon Data="{StaticResource IcGlobe}" Size="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Classes="h3" Text="{Binding Title}" />
            <TextBlock Classes="faint" Text="{Binding WildcardText}" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="2" Classes="icon ghost" VerticalAlignment="Top" Command="{Binding DismissCommand}" AutomationProperties.Name="Cerrar">
            <ctl:Icon Data="{StaticResource IcClose}" Size="15" />
          </Button>
        </Grid>

        <Border Background="{DynamicResource WinBrush}" CornerRadius="8" Padding="4,4">
          <StackPanel>
            <TextBlock Classes="faint" Margin="10,8" Text="Sin alias todavía." IsVisible="{Binding !HasAliases}" />
            <ItemsControl ItemsSource="{Binding Aliases}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AliasRow">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="10,4">
                    <TextBlock Classes="mono" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <ctl:Chip Grid.Column="1" Text="{Binding Kind}" Tone="Neutral" />
                    <Button Grid.Column="2" Classes="sm icon ghost" ToolTip.Tip="Quitar" AutomationProperties.Name="Quitar alias"
                            Command="{Binding $parent[ItemsControl].((vm:SiteAliasesDialogViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}">
                      <ctl:Icon Data="{StaticResource IcClose}" Size="13" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <StackPanel Spacing="6">
          <TextBlock Classes="lbl" Text="Añadir" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Classes="mono" Text="{Binding NewAlias}" PlaceholderText="{Binding PlaceholderText}" AutomationProperties.Name="Alias nuevo" />
            <Button Grid.Column="1" Content="Añadir" Command="{Binding AddCommand}" IsEnabled="{Binding CanAdd}" />
          </Grid>
          <TextBlock Classes="small" TextWrapping="Wrap" Text="{Binding Hint}" Foreground="{DynamicResource MutedBrush}" IsVisible="{Binding !HintIsError}" />
          <TextBlock Classes="small" TextWrapping="Wrap" Text="{Binding Hint}" Foreground="{DynamicResource BadBrush}" IsVisible="{Binding HintIsError}" />
        </StackPanel>

        <ctl:Note Tone="Accent" Content="{Binding ResolveText}" />
        <ctl:Note Tone="Warn" IsVisible="{Binding IsWordPress}"
                  Content="WordPress multisite con subdominios: cada sitio nuevo de la red es un subdominio. Con el hosts, cada uno necesita su línea (añádelos aquí); con el DNS local (Ajustes › Nombres .test) resuelven todos solos." />
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
