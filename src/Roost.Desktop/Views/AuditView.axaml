<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Roost.Desktop.ViewModels"
             xmlns:ctl="using:Roost.Desktop.Controls"
             xmlns:sys="using:System"
             x:Class="Roost.Desktop.Views.AuditView"
             x:DataType="vm:AuditViewModel">
  <ScrollViewer>
    <StackPanel>
      <Grid ColumnDefinitions="*,Auto" Margin="24,18,24,14">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Classes="h1" Text="Auditoría" />
          <TextBlock Classes="sub" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="Exportar (Markdown / JSON)" Command="{Binding ExportCommand}" />
          <Button Content="Volver a escanear" Command="{Binding RescanCommand}" IsEnabled="{Binding !Scanning}" ToolTip.Tip="Volver a escanear el equipo (F5)" />
        </StackPanel>
      </Grid>

      <StackPanel Margin="24,0,24,24" Spacing="16">
        <!-- Resumen -->
        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
          <Border Classes="card card-b">
            <StackPanel Spacing="4">
              <ctl:Chip Text="Rojo" Tone="Bad" ShowDot="True" />
              <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding Red}" />
              <TextBlock Classes="faint" Text="vulnerable o fin de vida" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="card card-b">
            <StackPanel Spacing="4">
              <ctl:Chip Text="Ámbar" Tone="Warn" ShowDot="True" />
              <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding Amber}" />
              <TextBlock Classes="faint" Text="sin verificar o conviene actualizar" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="card card-b">
            <StackPanel Spacing="4">
              <ctl:Chip Text="Verde" Tone="Ok" ShowDot="True" />
              <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding Green}" />
              <TextBlock Classes="faint" Text="al día" />
            </StackPanel>
          </Border>
          <Border Grid.Column="3" Classes="card card-b">
            <StackPanel Spacing="4">
              <ctl:Chip Text="Avisos" />
              <TextBlock FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" Text="{Binding DatasetDate}" />
              <TextBlock Classes="faint" Text="{Binding DatasetOrigin}" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- K1: qué ha cambiado desde la auditoría anterior (nuevos y resueltos) -->
        <ctl:Note Tone="{Binding ChangesTone}" IsVisible="{Binding HasChanges}">
          <StackPanel Spacing="4">
            <TextBlock Classes="strong" Text="{Binding ChangesText}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding ChangeLines}" IsVisible="{Binding HasChangeLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChangeLine">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <ctl:Dot Tone="{Binding Tone}" VerticalAlignment="Center" />
                    <TextBlock Classes="small" Text="{Binding Text}" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ctl:Note>

        <!-- Inventario -->
        <Border Classes="card">
          <StackPanel>
            <Border Classes="card-h">
              <DockPanel>
                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding IncludeOutside}">
                  <TextBlock Classes="small" Text="Incluir lo de fuera de Roost" />
                </CheckBox>
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Classes="h2" Text="Inventario" />
                  <Border Classes="seg">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                      <RadioButton Theme="{StaticResource SegButton}" GroupName="audit-filter" Content="Todo" IsChecked="{Binding ShowAll}" />
                      <RadioButton Theme="{StaticResource SegButton}" GroupName="audit-filter" Content="Rojo" IsChecked="{Binding ShowRed}" />
                      <RadioButton Theme="{StaticResource SegButton}" GroupName="audit-filter" Content="Ámbar" IsChecked="{Binding ShowAmber}" />
                      <RadioButton Theme="{StaticResource SegButton}" GroupName="audit-filter" Content="Verde" IsChecked="{Binding ShowGreen}" />
                    </StackPanel>
                  </Border>
                  <TextBlock Classes="hint" Text="{Binding ScanText}" />
                </StackPanel>
              </DockPanel>
            </Border>
            <!-- K1: por tipo y por origen -->
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,10,16,10">
              <TextBlock Classes="muted" Text="Tipo" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding KindChoices}" SelectedItem="{Binding KindFilter}" MinWidth="150" AutomationProperties.Name="Tipo" />
              <TextBlock Classes="muted" Text="Origen" VerticalAlignment="Center" Margin="8,0,0,0" />
              <ComboBox ItemsSource="{Binding SourceChoices}" SelectedItem="{Binding SourceFilter}" MinWidth="160" AutomationProperties.Name="Origen" />
            </StackPanel>
            <Border Classes="th">
              <Grid ColumnDefinitions="16,1.5*,0.9*,*,2*" ColumnSpacing="12">
                <TextBlock Grid.Column="1" Text="Componente" />
                <TextBlock Grid.Column="2" Text="Origen" />
                <TextBlock Grid.Column="3" Text="Veredicto" />
                <TextBlock Grid.Column="4" Text="Detalle" />
              </Grid>
            </Border>
            <TextBlock Classes="muted" Margin="16,12" IsVisible="{Binding !HasRows}"
                       Text="{Binding Scanning, Converter={x:Static ctl:ValueConverters.ScanningText}}" />
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AuditRow">
                  <Button Classes="row" Classes.sel="{Binding IsSelected}"
                          Command="{Binding $parent[ItemsControl].((vm:AuditViewModel)DataContext).ChooseCommand}" CommandParameter="{Binding}"
                          AutomationProperties.Name="{Binding Version, StringFormat='Componente {0}'}">
                    <Border Classes="tr" Padding="16,9">
                      <Grid ColumnDefinitions="16,1.5*,0.9*,*,2*" ColumnSpacing="12">
                        <ctl:Dot Tone="{Binding Tone}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock>
                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text=" " />
                            <Run Text="{Binding Version, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                          </TextBlock>
                          <TextBlock Classes="faint" Text="{Binding Variant}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Classes="small" Text="{Binding Source}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <ctl:Chip Grid.Column="3" Text="{Binding Verdict}" Tone="{Binding Tone}" />
                        <TextBlock Grid.Column="4" Classes="small muted" Text="{Binding Detail}" TextWrapping="Wrap" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Detalle -->
        <Border Classes="card" IsVisible="{Binding HasSelection}">
          <StackPanel>
            <Border Classes="card-h">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                  <Button Classes="sm ghost" Content="{Binding IgnoreLabel}" Command="{Binding ToggleIgnoreCommand}"
                          ToolTip.Tip="Lo ignorado no cuenta en rojo ni avisa en la bandeja; sale abajo, en Ignorados, y se puede deshacer" />
                  <Button Classes="sm primary" Content="{Binding ActionLabel}" Command="{Binding ActCommand}" IsVisible="{Binding HasAction}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <ctl:Dot Tone="{Binding Selected.Tone, FallbackValue=Off}" VerticalAlignment="Center" />
                  <TextBlock Classes="h2" Text="{Binding SelectedTitle}" />
                  <ctl:Chip Text="{Binding Selected.Verdict, FallbackValue=''}" Tone="{Binding Selected.Tone, FallbackValue=Neutral}" />
                </StackPanel>
              </DockPanel>
            </Border>
            <StackPanel Margin="16,14" Spacing="12">
              <SelectableTextBlock Classes="mono faint" Text="{Binding Selected.Finding.Component.ExecutablePath, FallbackValue=''}" />
              <TextBlock Text="{Binding LongText}" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="16" IsVisible="{Binding HasAdvisories}">
                <StackPanel Spacing="6">
                  <TextBlock Classes="lbl" Text="Avisos" />
                  <ItemsControl ItemsSource="{Binding Advisories}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AdvisoryLine">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <!-- K1: el aviso se abre en el navegador -->
                            <Button Classes="link" IsVisible="{Binding HasUrl}" ToolTip.Tip="{Binding Url}" VerticalAlignment="Center"
                                    Command="{Binding $parent[ItemsControl].((vm:AuditViewModel)DataContext).OpenAdvisoryCommand}" CommandParameter="{Binding}">
                              <TextBlock Classes="mono strong" Text="{Binding Id}" />
                            </Button>
                            <TextBlock Classes="mono strong" Text="{Binding Id}" VerticalAlignment="Center" IsVisible="{Binding !HasUrl}" />
                            <TextBlock Classes="small" Text="{Binding Meta, StringFormat='· {0}'}" VerticalAlignment="Center" />
                            <ctl:Chip Text="KEV" Tone="Bad" IsVisible="{Binding Kev}" />
                          </StackPanel>
                          <TextBlock Classes="faint" Text="{Binding Title}" TextWrapping="Wrap" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <!-- K4: cada mitigación frente a lo que aplica PHP (php -i), con «Aplicar» y «Deshacer» en los de Roost -->
                <StackPanel Grid.Column="1" Spacing="6" IsVisible="{Binding HasMitigations}">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="sm" Content="Aplicar todas" IsVisible="{Binding CanApplyAll}"
                            Command="{Binding ApplyAllMitigationsCommand}"
                            ToolTip.Tip="Escribe las que faltan en el fichero de mitigaciones de su rama y reinicia solo su pool" />
                    <TextBlock Classes="lbl" Text="Mitigaciones (no sustituyen al parche)" VerticalAlignment="Center" />
                  </DockPanel>
                  <ItemsControl ItemsSource="{Binding Mitigations}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MitigationLine">
                        <Border BorderBrush="{DynamicResource Line2Brush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="3">
                            <TextBlock Classes="mono strong" Text="{Binding Setting}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <ctl:Chip Grid.Column="1" Text="{Binding Status}" Tone="{Binding Tone}" ShowDot="True" VerticalAlignment="Top" />
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="faint" Text="{Binding Note}" TextWrapping="Wrap" IsVisible="{Binding HasNote}" />
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="small" Text="{Binding Detail}" TextWrapping="Wrap" IsVisible="{Binding HasDetail}" />
                            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6" Margin="0,4,0,0" IsVisible="{Binding HasActions}">
                              <Button Classes="sm primary" Content="Aplicar" IsVisible="{Binding CanApply}"
                                      Command="{Binding $parent[ItemsControl].((vm:AuditViewModel)DataContext).ApplyMitigationCommand}" CommandParameter="{Binding}"
                                      ToolTip.Tip="La escribe en el fichero de mitigaciones de Roost de su rama y reinicia solo su pool" />
                              <Button Classes="sm ghost" Content="Deshacer" IsVisible="{Binding CanUndo}"
                                      Command="{Binding $parent[ItemsControl].((vm:AuditViewModel)DataContext).UndoMitigationCommand}" CommandParameter="{Binding}"
                                      ToolTip.Tip="La quita del fichero de mitigaciones de Roost y reinicia solo su pool" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="faint" Text="{Binding MitigationNote}" TextWrapping="Wrap" IsVisible="{Binding MitigationNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <TextBlock Classes="faint mono" FontSize="11" Text="{Binding IniFilesText}" TextWrapping="Wrap" IsVisible="{Binding IniFilesText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <TextBlock Classes="faint" Text="{Binding RealFix}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- K1: lo ignorado, aparte y con «Dejar de ignorar» -->
        <Border Classes="card" IsVisible="{Binding HasIgnored}">
          <StackPanel>
            <Border Classes="card-h">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="h2" Text="{Binding IgnoredTitle}" />
                <TextBlock Classes="hint" Text="No cuentan en rojo ni avisan en la bandeja" />
              </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding IgnoredRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AuditRow">
                  <Border Classes="tr" Padding="16,9">
                    <Grid ColumnDefinitions="16,1.5*,0.9*,*,Auto" ColumnSpacing="12">
                      <ctl:Dot Tone="{Binding Tone}" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Classes="link" HorizontalAlignment="Left" VerticalAlignment="Center"
                              Command="{Binding $parent[ItemsControl].((vm:AuditViewModel)DataContext).ChooseCommand}" CommandParameter="{Binding}">
                        <TextBlock>
                          <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                          <Run Text=" " />
                          <Run Text="{Binding Version, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                        </TextBlock>
                      </Button>
                      <TextBlock Grid.Column="2" Classes="small" Text="{Binding Source}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <ctl:Chip Grid.Column="3" Text="{Binding Verdict}" Tone="{Binding Tone}" />
                      <Button Grid.Column="4" Classes="sm ghost" Content="Dejar de ignorar"
                              Command="{Binding $parent[ItemsControl].((vm:AuditViewModel)DataContext).UnignoreCommand}" CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Servicios (oleada 3): servicios de Windows que se quedan los puertos (E7) -->
        <Border Classes="card">
          <StackPanel>
            <Border Classes="card-h">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                  <Button Classes="sm ghost" Content="Volver a mirar" Command="{Binding RecheckServicesCommand}" />
                  <Button Classes="sm" Content="Abrir Servicios de Windows" Command="{Binding OpenServicesPanelCommand}"
                          ToolTip.Tip="services.msc: ahí se deja un servicio en Manual (Tipo de inicio) y se detiene" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Classes="h2" Text="Servicios de Windows" />
                  <ctl:Chip Text="{Binding ServicesSummary}" Tone="{Binding ServicesTone}" ShowDot="True" />
                </StackPanel>
              </DockPanel>
            </Border>
            <StackPanel Margin="16,14" Spacing="12">
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="Un MySQL o una MariaDB instalados con su instalador, Apache, IIS u otro Redis arrancan con Windows y se quedan el puerto antes que Roost. Roost no cambia servicios de Windows: te dice cuáles son y cómo dejarlos en Manual." />
              <ItemsControl ItemsSource="{Binding ServiceRows}" IsVisible="{Binding HasServiceRows}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:WindowsServiceRow">
                    <Border BorderBrush="{DynamicResource Line2Brush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                      <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="4">
                        <ctl:Dot Tone="{Binding Tone}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                          <TextBlock Classes="strong" Text="{Binding Title}" VerticalAlignment="Center" />
                          <ctl:Chip Text="{Binding Kind}" />
                        </StackPanel>
                        <ctl:Chip Grid.Column="2" Text="{Binding State}" Tone="{Binding Tone}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Classes="small" Text="{Binding Detail}" TextWrapping="Wrap" />
                        <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                          <TextBlock Classes="faint" Text="En Manual:" VerticalAlignment="Center" />
                          <SelectableTextBlock Grid.Column="1" Classes="mono" FontSize="12" Text="{Binding Command}" VerticalAlignment="Center" />
                          <Button Grid.Column="2" Classes="sm ghost" Content="Copiar"
                                  Command="{Binding $parent[ItemsControl].((vm:AuditViewModel)DataContext).CopyServiceCommandCommand}" CommandParameter="{Binding}"
                                  ToolTip.Tip="Para una consola de administrador; o hazlo en Servicios de Windows (Tipo de inicio: Manual)" />
                        </Grid>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
