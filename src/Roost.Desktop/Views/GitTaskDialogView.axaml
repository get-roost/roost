<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Roost.Desktop.ViewModels"
             xmlns:ctl="using:Roost.Desktop.Controls"
             x:Class="Roost.Desktop.Views.GitTaskDialogView"
             x:DataType="vm:GitTaskDialogViewModel">
  <!-- Git-app: Clonando / Actualizando / Cambiando de rama (maqueta D del diseño de git) -->
  <Border Classes="modal" Width="560">
    <DockPanel>
      <Border DockPanel.Dock="Bottom" Classes="modal-f">
        <DockPanel>
          <Button DockPanel.Dock="Left" Content="Seguir en segundo plano" Command="{Binding BackgroundCommand}" IsVisible="{Binding ShowBackground}" />
          <Button DockPanel.Dock="Left" Content="Abrir el registro" Command="{Binding OpenLogCommand}" IsVisible="{Binding ShowLog}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancelar" Command="{Binding CancelCommand}" IsVisible="{Binding ShowCancel}"
                    ToolTip.Tip="Para git y todo lo que haya lanzado" />
            <Button Classes="primary" Content="Cerrar" Command="{Binding CancelCommand}" IsVisible="{Binding Done}" />
          </StackPanel>
        </DockPanel>
      </Border>
      <StackPanel Spacing="14" Margin="20,18,20,18">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Border Classes="badge-ic" Classes.bad="{Binding Failed}">
            <ctl:Icon Data="{StaticResource IcDownload}" Size="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Classes="h3" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="faint" Text="{Binding Subtitle}" TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding Subtitle}" />
          </StackPanel>
        </Grid>

        <StackPanel Spacing="6">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Classes="mono" Text="{Binding ProgressText}" />
            <TextBlock Classes="small strong" Text="{Binding Phase}" />
          </DockPanel>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" IsIndeterminate="{Binding Indeterminate}"
                       IsVisible="{Binding Running}" AutomationProperties.Name="Progreso" />
          <TextBlock Classes="faint mono" FontSize="11" Text="{Binding LastLine}" TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding HasLastLine}" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Steps}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:GitStep">
              <Grid ColumnDefinitions="Auto,170,*" ColumnSpacing="10">
                <Border Width="22" Height="22" CornerRadius="11"
                        Classes="step" Classes.done="{Binding IsDone}" Classes.active="{Binding IsActive}"
                        Classes.failed="{Binding Tone, Converter={x:Static ctl:ToneConverters.IsBad}}">
                  <Panel>
                    <ctl:Icon Data="{StaticResource IcCheck}" Size="13" StrokeThickness="2.4" IsVisible="{Binding IsDone}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <ctl:Icon Data="{StaticResource IcDot}" Size="12" Filled="True" IsVisible="{Binding !IsDone}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Panel>
                </Border>
                <TextBlock Grid.Column="1" Classes="small" VerticalAlignment="Center" Text="{Binding Label}"
                           FontWeight="{Binding IsActive, Converter={x:Static ctl:ToneConverters.Bold}}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="2" Classes="small" VerticalAlignment="Center" Text="{Binding Hint}" Foreground="{DynamicResource FaintBrush}"
                           TextWrapping="Wrap" IsVisible="{Binding HasHint}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ctl:Note Tone="Bad" IsVisible="{Binding Failed}">
          <StackPanel Spacing="6">
            <SelectableTextBlock Text="{Binding Error}" TextWrapping="Wrap" />
            <SelectableTextBlock Classes="mono" FontSize="11.5" Text="{Binding ErrorDetail}" TextWrapping="Wrap" IsVisible="{Binding HasErrorDetail}" />
          </StackPanel>
        </ctl:Note>
        <ctl:Note Tone="Accent" IsVisible="{Binding !Failed}" Content="{Binding Note}" />
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
